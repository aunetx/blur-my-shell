<?xml version="1.0" encoding="UTF-8"?>
<interface domain="blur-my-shell@aunetx">
  <template class="Dash" parent="AdwPreferencesPage">
    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwSwitchRow" id="blur">
            <property name="title" translatable="yes">Blur</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="BlurModeRow" id="blur_mode_row">
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="unblur_in_overview">
            <property name="title" translatable="yes">Disable in overview</property>
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Pipeline</property>

        <child>
          <object class="AdwSwitchRow" id="pipeline_auto_mode_switch">
            <property name="title" translatable="yes">Follow system theme</property>
            <property name="subtitle" translatable="yes">Automatically switch the pipeline based on the system theme.</property>
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_row">
            <property name="title" translatable="yes">Normal</property>
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_auto_light_row">
            <property name="title" translatable="yes">Light</property>
            <property name="subtitle" translatable="yes">The pipeline used for light mode</property>
            <property name="sensitive" bind-source="pipeline_auto_mode_switch" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_auto_dark_row">
            <property name="title" translatable="yes">Dark</property>
            <property name="subtitle" translatable="yes">The pipeline used for dark mode</property>
            <property name="sensitive" bind-source="pipeline_auto_mode_switch" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Background</property>
        <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />

        <child>
          <object class="AdwSwitchRow" id="override_background">
            <property name="title" translatable="yes">Override background</property>
          </object>
        </child>

        <child>
          <object class="AdwComboRow" id="style_dash_to_dock">
            <property name="title" translatable="yes">Background style</property>
            <property name="model">style_dash_to_dock_model</property>
            <property name="sensitive" bind-source="override_background" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>
  </template>

  <object class="GtkStringList" id="style_dash_to_dock_model">
    <items>
      <item translatable="yes">Transparent</item>
      <item translatable="yes">Light</item>
      <item translatable="yes">Dark</item>
      <item translatable="yes">Automatic</item>
    </items>
  </object>
</interface>
