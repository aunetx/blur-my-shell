<?xml version="1.0" encoding="UTF-8"?>
<interface domain="blur-my-shell@aunetx">
  <template class="PopupBlur" parent="AdwPreferencesPage">
    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwSwitchRow" id="blur">
            <property name="title" translatable="yes">Blur</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="BlurModeRow" id="blur_mode_row">
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_behind_dialogs">
            <property name="title" translatable="yes">Blur behind dialogs</property>
            <property name="subtitle" translatable="yes">Blur the dimmed screen behind system dialogs, like the power off dialog.</property>
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Pipeline</property>

        <child>
          <object class="AdwSwitchRow" id="pipeline_auto_mode_switch">
            <property name="title" translatable="yes">Follow system theme</property>
            <property name="subtitle" translatable="yes">Automatically switch the pipeline based on the system theme.</property>
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_row">
            <property name="title" translatable="yes">Normal</property>
            <property name="visible" bind-source="pipeline_auto_mode_switch" bind-property="active" bind-flags="sync-create|invert-boolean" />
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_auto_light_row">
            <property name="title" translatable="yes">Light</property>
            <property name="subtitle" translatable="yes">The pipeline used for light mode</property>
            <property name="visible" bind-source="pipeline_auto_mode_switch" bind-property="active" bind-flags="sync-create" />
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="PipelineChooseRow" id="pipeline_choose_auto_dark_row">
            <property name="title" translatable="yes">Dark</property>
            <property name="subtitle" translatable="yes">The pipeline used for dark mode</property>
            <property name="visible" bind-source="pipeline_auto_mode_switch" bind-property="active" bind-flags="sync-create" />
            <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Blurred popups</property>
        <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />

        <child>
          <object class="AdwSwitchRow" id="blur_menus">
            <property name="title" translatable="yes">Menus</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_candidates">
            <property name="title" translatable="yes">Input method candidates</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_quick_settings">
            <property name="title" translatable="yes">Quick settings</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_submenus">
            <property name="title" translatable="yes">Quick settings submenus</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_screenshot">
            <property name="title" translatable="yes">Screenshot panel</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_calendar">
            <property name="title" translatable="yes">Calendar and notification center</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_notifications">
            <property name="title" translatable="yes">Notifications</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_switchers">
            <property name="title" translatable="yes">Window and workspace switchers</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_osds">
            <property name="title" translatable="yes">Volume and brightness</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_resize_popups">
            <property name="title" translatable="yes">Window resize hints</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_dialogs">
            <property name="title" translatable="yes">Dialogs</property>
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="blur_keyboard">
            <property name="title" translatable="yes">On-screen keyboard</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Background</property>
        <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />

        <child>
          <object class="AdwSwitchRow" id="override_background">
            <property name="title" translatable="yes">Override background</property>
          </object>
        </child>

        <child>
          <object class="AdwComboRow" id="style_popup">
            <property name="title" translatable="yes">Background style</property>
            <property name="model">style_popup_model</property>
            <property name="sensitive" bind-source="override_background" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>

        <child>
          <object class="AdwSwitchRow" id="preserve_shell_theme">
            <property name="title" translatable="yes">Preserve shell theme</property>
            <property name="subtitle" translatable="yes">Keep your shell theme's colors for popup controls.</property>
            <property name="sensitive" bind-source="override_background" bind-property="active" bind-flags="sync-create" />
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Corner radius</property>
        <property name="sensitive" bind-source="blur" bind-property="active" bind-flags="sync-create" />

        <child>
          <object class="AdwComboRow" id="rounded_corners">
            <property name="title" translatable="yes">Rounded corners</property>
            <property name="model">rounded_corners_model</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Menus</property>
            <property name="adjustment">menu_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Input method candidates</property>
            <property name="adjustment">candidate_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Quick settings</property>
            <property name="adjustment">quick_settings_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Quick settings submenus</property>
            <property name="adjustment">submenu_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Screenshot panel</property>
            <property name="adjustment">screenshot_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Calendar and notification center</property>
            <property name="adjustment">calendar_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Notifications</property>
            <property name="adjustment">notification_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Window and workspace switchers</property>
            <property name="adjustment">osd_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Volume and brightness</property>
            <property name="adjustment">osd_window_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Window resize hints</property>
            <property name="adjustment">resize_popup_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Dialogs</property>
            <property name="adjustment">dialog_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">On-screen keyboard</property>
            <property name="adjustment">osk_corner_radius</property>
          </object>
        </child>

        <child>
          <object class="AdwSpinRow">
            <property name="title" translatable="yes">Other popup surfaces</property>
            <property name="adjustment">corner_radius</property>
          </object>
        </child>
      </object>
    </child>
  </template>

  <object class="GtkStringList" id="rounded_corners_model">
    <items>
      <item translatable="yes">All</item>
      <item translatable="yes">Top only</item>
      <item translatable="yes">Bottom only</item>
      <item translatable="yes">None</item>
    </items>
  </object>

  <object class="GtkStringList" id="style_popup_model">
    <items>
      <item translatable="yes">Transparent</item>
      <item translatable="yes">Light</item>
      <item translatable="yes">Dark</item>
      <item translatable="yes">Automatic</item>
    </items>
  </object>

  <object class="GtkAdjustment" id="menu_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="candidate_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="quick_settings_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="screenshot_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="submenu_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="calendar_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="notification_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="osd_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="osd_window_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="resize_popup_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="dialog_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="osk_corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkAdjustment" id="corner_radius">
    <property name="lower">0</property>
    <property name="upper">150</property>
    <property name="step-increment">1</property>
  </object>
</interface>
