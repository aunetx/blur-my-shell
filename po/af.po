#: resources/ui/pages/shell/app-folders.ui:21
#: resources/ui/pages/shell/component.ui:20 resources/ui/pages/shell/dash.ui:37
#: resources/ui/pages/shell/overview.ui:21 resources/ui/pages/shell/panel.ui:37
#: resources/ui/pages/shell/popup.ui:38
msgid "Follow system theme"
msgstr "Volg stelseltema"

#: resources/ui/pages/applications.ui:35
#: resources/ui/pages/shell/app-folders.ui:22
#: resources/ui/pages/shell/component.ui:21 resources/ui/pages/shell/dash.ui:38
#: resources/ui/pages/shell/overview.ui:22 resources/ui/pages/shell/panel.ui:38
#: resources/ui/pages/shell/popup.ui:39
msgid "Automatically switch the pipeline based on the system theme."
msgstr "Wissel die effekreeks outomaties volgens die stelseltema."

#: resources/ui/pages/applications.ui:50
#: resources/ui/pages/shell/app-folders.ui:35
#: resources/ui/pages/shell/app-folders.ui:77
