msgid "Blur"
msgstr "Vervaging"

#: src/effects/effect_groups.js:18
msgid "Texture"
msgstr "Tekstuur"

#: src/effects/effect_groups.js:27
msgid "Advanced"
msgstr "Gevorderd"

#: src/effects/effect_groups.js:28
msgid "Building blocks that are mostly useful combined with other effects."
msgstr "Boustene wat meestal saam met ander effekte nuttig is."

# Effect name, kept in English.
#: src/effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "Liquid Glass"

#: src/effects/refraction/info.js:8
msgid ""
"A glossy translucent material with edge refraction, rim lighting, tint, and "
"inner shadow."
msgstr ""
"'n Glansende, deurskynende materiaal met ligbreking by die rand, "
"randbeligting, 'n kleurtint en 'n binneskaduwee."

#: src/effects/refraction/info.js:11
msgid "Refraction scale"
msgstr "Brekingskaal"

#: src/effects/refraction/info.js:12
msgid "How strongly the glass bends the sampled blur texture."
msgstr "Hoe sterk die glas die gemonsterde vervaagtekstuur buig."

#: src/effects/refraction/info.js:21
msgid "Blur radius"
msgstr "Vervaagradius"

#: src/effects/refraction/info.js:22
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr ""
"Vervaag die gemonsterde agtergrond voordat die Liquid Glass-effek toegepas "
"word."

#: src/effects/refraction/info.js:31
msgid "Bezel width"
msgstr "Raambreedte"

#: src/effects/refraction/info.js:32
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "Hoe ver die Liquid Glass-lens van die rand af na binne strek."

#: src/effects/refraction/info.js:41
msgid "Rim spread"
msgstr "Randverspreiding"

#: src/effects/refraction/info.js:42
msgid "How far the refraction eases inward from the glass edge."
msgstr "Hoe ver die ligbreking geleidelik van die glasrand af na binne strek."

#: src/effects/refraction/info.js:51
msgid "Refraction reach"
msgstr "Brekingsreikwydte"

#: src/effects/refraction/info.js:52
msgid ""
"How far the bend reaches inward from the edge, past the corner radius. A "
"wider bend is also deeper, like a wider bezel (0 keeps it at the rim)."
msgstr ""
"Hoe ver die buiging van die rand af na binne strek, verby die hoekradius. 'n "
"Wyer buiging is ook dieper, soos 'n wyer raam (0 hou dit by die rand)."

#: src/effects/refraction/info.js:61
msgid "Glass thickness"
msgstr "Glasdikte"

#: src/effects/refraction/info.js:62
msgid "Depth used by the refraction edge profile."
msgstr "Diepte wat die brekingsprofiel van die rand gebruik."

#: src/effects/refraction/info.js:71
msgid "Refraction style"
msgstr "Brekingstyl"

#: src/effects/refraction/info.js:72
msgid ""
"Shape of the bend near the edge. Low values bend softly, higher values bend "
"more sharply right at the edge."
msgstr ""
"Vorm van die buiging naby die rand. Lae waardes buig sag, hoër waardes buig "
"skerper reg by die rand."

#: src/effects/refraction/info.js:81
msgid "Fresnel glare"
msgstr "Fresnel-glans"

#: src/effects/refraction/info.js:82
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "Sterkte van die gerigte Fresnel-glans van die glasrand af."

#: src/effects/refraction/info.js:91
msgid "Fresnel glare angle"
msgstr "Fresnel-glanshoek"

#: src/effects/refraction/info.js:92
msgid ""
"Axis of the fresnel glare, lighting two opposite edges, in degrees (0 lights "
"the top and bottom, positive rotates clockwise)."
msgstr ""
"Die as van die Fresnel-glans, wat twee teenoorgestelde rande belig, in grade "
"(0 belig die boonste en onderste rand, positief draai kloksgewys)."

#: src/effects/refraction/info.js:101
msgid "Fresnel glare width"
msgstr "Fresnel-glansbreedte"

#: src/effects/refraction/info.js:102
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "Diktevermenigvuldiger van die Fresnel-glansring langs die glasrand."

#: src/effects/refraction/info.js:111
msgid "Specular glare strength"
msgstr "Sterkte van spieëlglans"

#: src/effects/refraction/info.js:112
msgid ""
"Strength of the white specular glare on the same edge pair as the fresnel "
"glare, brighter on the light side (0 disables it)."
msgstr ""
"Sterkte van die wit spieëlglans op dieselfde randpaar as die Fresnel-glans, "
"helderder aan die kant van die lig (0 skakel dit af)."

#: src/effects/refraction/info.js:121
msgid "Edge border"
msgstr "Randlyn"

#: src/effects/refraction/info.js:122
msgid ""
"Thin dark line along the straight side edges, away from the fresnel glare, "
"outlining the glass on light backgrounds."
msgstr ""
"Dun, donker lyn langs die reguit syrande, weg van die Fresnel-glans, wat die "
"glas op ligte agtergronde omlyn."

#: src/effects/refraction/info.js:131
msgid "Edge glow"
msgstr "Randgloed"

#: src/effects/refraction/info.js:132
msgid "Colorful content under the glass lights up its edge."
msgstr "Kleurryke inhoud onder die glas laat die rand daarvan gloei."

#: src/effects/refraction/info.js:141
msgid "Tint strength"
msgstr "Tintsterkte"

#: src/effects/refraction/info.js:142
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr "Hoeveelheid subtiele melkglastint oor die vervaagde tekstuur."

#: src/effects/refraction/info.js:151
msgid "Tint color"
msgstr "Tintkleur"

#: src/effects/refraction/info.js:152
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr ""
"Kleur wat oor die vervaagde tekstuur ingemeng word, volgens die tintsterkte."

#: src/effects/refraction/info.js:157
msgid "Backdrop zoom"
msgstr "Agtergrondzoem"

#: src/effects/refraction/info.js:158
msgid "Zoom level of the backdrop visible through the glass."
msgstr "Zoemvlak van die agtergrond wat deur die glas sigbaar is."

#: src/effects/refraction/info.js:167
msgid "Inner shadow"
msgstr "Binneskaduwee"

#: src/effects/refraction/info.js:168
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr "Verdonker die onderste en binneste rand vir 'n dieper glasoppervlak."

#: src/effects/refraction/info.js:177
msgid "Chromatic dispersion"
msgstr "Chromatiese dispersie"

#: src/effects/refraction/info.js:178
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "Fisiese brekingsdispersie per kleurkanaal by die glasrand."

#: src/effects/refraction/info.js:187
msgid "Edge behavior"
msgstr "Randgedrag"

#: src/effects/refraction/info.js:188
msgid "How texture coordinates outside the actor are sampled."
msgstr "Hoe tekstuurkoördinate buite die element gemonster word."

#: src/effects/refraction/info.js:191
msgid "Clamp"
msgstr "Vasklem"

#: src/effects/refraction/info.js:192
msgid "Mirror"
msgstr "Spieël"

#: src/effects/texture/info.js:11
msgid "Pixelize"
msgstr "Pikseleer"

#: src/effects/texture/info.js:12
msgid "An effect that pixelizes the image."
msgstr "'n Effek wat die beeld pikseleer."

#: src/effects/texture/info.js:15 src/effects/texture/info.js:40
#: src/effects/texture/info.js:65
msgid "Factor"
msgstr "Faktor"

#: src/effects/texture/info.js:16 src/effects/texture/info.js:41
msgid "How much to scale down the image."
msgstr "Hoeveel om die beeld te verklein."

#: src/effects/texture/info.js:23 src/effects/texture/info.js:48
msgid "Downsampling mode"
msgstr "Afmonsteringsmodus"

#: src/effects/texture/info.js:24 src/effects/texture/info.js:49
msgid "The downsampling method that is used."
msgstr "Die afmonsteringsmetode wat gebruik word."

#: src/effects/texture/info.js:27 src/effects/texture/info.js:52
msgid "Boxcar"
msgstr "Boks"

#: src/effects/texture/info.js:28 src/effects/texture/info.js:53
msgid "Triangular"
msgstr "Driehoekig"

#: src/effects/texture/info.js:29 src/effects/texture/info.js:54
msgid "Dirac"
msgstr "Dirac"

#: src/effects/texture/info.js:36
msgid "Downscale (advanced effect)"
msgstr "Verklein (gevorderde effek)"

#: src/effects/texture/info.js:37
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "'n Effek wat die beeld verklein en dit in die linkerbohoek plaas."

#: src/effects/texture/info.js:61
msgid "Upscale (advanced effect)"
msgstr "Vergroot (gevorderde effek)"

#: src/effects/texture/info.js:62
msgid "An effect that upscales the image from the top-left corner."
msgstr "'n Effek wat die beeld vanaf die linkerbohoek vergroot."

#: src/effects/texture/info.js:66
msgid "How much to scale up the image."
msgstr "Hoeveel om die beeld te vergroot."

#: src/effects/texture/info.js:76
msgid "Derivative"
msgstr "Afgeleide"

#: src/effects/texture/info.js:77
msgid "Apply a spatial derivative, or a laplacian."
msgstr "Pas 'n ruimtelike afgeleide of 'n Laplace-operator toe."

#: src/effects/texture/info.js:80
msgid "Operation"
msgstr "Bewerking"

#: src/effects/texture/info.js:81
msgid "The mathematical operation to apply."
msgstr "Die wiskundige bewerking om toe te pas."

#: src/effects/texture/info.js:84
msgid "1-step derivative"
msgstr "1-stap-afgeleide"

#: src/effects/texture/info.js:85
msgid "2-step derivative"
msgstr "2-stap-afgeleide"

#: src/effects/texture/info.js:86
msgid "Laplacian"
msgstr "Laplace-operator"

#: src/effects/texture/info.js:93 src/effects/texture/info.js:97
msgid "Noise"
msgstr "Ruis"

#: src/effects/texture/info.js:94
msgid "An effect that adds random grain to the image."
msgstr "'n Effek wat lukrake korrels by die beeld voeg."

#: src/effects/texture/info.js:98
msgid "The amount of noise to add."
msgstr "Die hoeveelheid ruis om by te voeg."

#: src/effects/texture/info.js:107
msgid "Lightness"
msgstr "Ligtheid"

#: src/effects/texture/info.js:108
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr ""
"Die ligsterkte van die ruis. 'n Waarde van '1.0' maak die effek deursigtig."

# Effect name, kept in English.
#: src/effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "Vapor Wave"

#: src/effects/wave/info.js:8
msgid ""
"A flowing wave displacement for a lively and dynamic feel with natural "
"movement."
msgstr ""
"'n Vloeiende golfverplasing vir 'n lewendige, dinamiese gevoel met "
"natuurlike beweging."

#: src/effects/wave/info.js:11
msgid "Wave frequency"
msgstr "Golffrekwensie"

#: src/effects/wave/info.js:12
msgid "How tightly packed the ripples are."
msgstr "Hoe dig die rimpels op mekaar gepak is."

#: src/effects/wave/info.js:21
msgid "Wave amplitude"
msgstr "Golfamplitude"

#: src/effects/wave/info.js:22
msgid "How strongly the image gets displaced by the waves."
msgstr "Hoe sterk die golwe die beeld verskuif."

#: src/effects/wave/info.js:31
msgid "Wave octaves"
msgstr "Golfoktawe"

#: src/effects/wave/info.js:32
msgid ""
"Detail level of the wave shape. Higher adds more detail at the cost of "
"performance."
msgstr ""
"Detailvlak van die golfvorm. Hoër voeg meer detail by, ten koste van "
"werkverrigting."

#: src/effects/wave/info.js:39
msgid "Vapor octaves"
msgstr "Dampoktawe"

#: src/effects/wave/info.js:40
msgid ""
"Detail level of the misty texture. Higher adds more detail at the cost of "
"performance."
msgstr ""
"Detailvlak van die mistige tekstuur. Hoër voeg meer detail by, ten koste van "
"werkverrigting."

#: src/effects/wave/info.js:47
msgid "Vapor speed"
msgstr "Dampspoed"

#: src/effects/wave/info.js:48
msgid "How quickly the misty vapor texture drifts over time."
msgstr "Hoe vinnig die mistige damptekstuur met verloop van tyd dryf."

#: src/effects/wave/info.js:57
msgid "Texture grain"
msgstr "Tekstuurkorrel"

#: src/effects/wave/info.js:58
msgid "Adds a fine sandblasted texture to the image."
msgstr "Voeg 'n fyn, sandgestraalde tekstuur by die beeld."

#: src/effects/wave/info.js:68
msgid "The saturation of the effect."
msgstr "Die versadiging van die effek."

#: src/effects/wave/info.js:78
msgid "The brightness of the effect."
msgstr "Die helderheid van die effek."

#: src/effects/wave/info.js:87
msgid "Zoom"
msgstr "Zoem"

#: src/effects/wave/info.js:88
msgid "Magnifies the backdrop toward the surface's center."
msgstr "Vergroot die agtergrond na die middel van die oppervlak toe."

#: src/effects/wave/info.js:97
msgid "Dispersion"
msgstr "Dispersie"

#: src/effects/wave/info.js:98
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "Sterkte van kleuraberrasie vir 'n haperende gevoel."

#: src/effects/wave/info.js:107
msgid "Enable flow animation"
msgstr "Aktiveer vloei-animasie"

#: src/effects/wave/info.js:108
msgid "Whether the wave noise continuously flows over time."
msgstr "Of die golfruis voortdurend met verloop van tyd vloei."

#: src/effects/wave/info.js:112
msgid "Flow animation speed"
msgstr "Spoed van vloei-animasie"

#: src/effects/wave/info.js:113
msgid "The base speed at which the wave pattern flows."
msgstr "Die basisspoed waarteen die golfpatroon vloei."

#: src/effects/wave/info.js:122
msgid "Resize ease duration"
msgstr "Oorgangsduur by grootteverandering"

#: src/effects/wave/info.js:123
msgid ""
"How long the effect takes to adjust when a window changes size "
"(milliseconds)."
msgstr ""
"Hoe lank die effek neem om aan te pas wanneer 'n venster van grootte "
"verander (millisekondes)."

