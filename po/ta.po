#: src/effects/effects.js:19
msgid "Dual Kawase blur"
msgstr ""

#: src/effects/effects.js:20
msgid "A fast multi-resolution blur shared by static and dynamic surfaces."
msgstr ""

#: src/effects/effects.js:24
msgid "Radius"
msgstr "ஆரம்"

#: src/effects/effects.js:25
msgid "The intensity of the blur effect."
msgstr "மங்கலான விளைவின் தீவிரம்."

#: src/effects/effects.js:34 resources/ui/overview.ui:75
msgid "Brightness"
msgstr "பிரகாசம்"

#: src/effects/effects.js:35 resources/ui/overview.ui:76
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr "மங்கலான விளைவின் பிரகாசம், அதிக மதிப்பு உரையைப் படிக்க கடினமாக்கலாம்."

#: src/effects/effects.js:48 src/effects/effects.js:54
#: src/effects/effects.js:80
msgid "Color"
msgstr "நிறம்"

#: src/effects/effects.js:49
msgid "An effect that blends a color into the pipeline."
msgstr "குழாயில் ஒரு நிறத்தை கலக்கும் விளைவு."

#: src/effects/effects.js:55
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr ""

#: src/effects/effects.js:60
msgid "Blend mode"
msgstr "கலப்பு முறை"

#: src/effects/effects.js:61
msgid "How the color is blended in."
msgstr "வண்ணம் எவ்வாறு கலக்கப்படுகிறது."

#: src/effects/effects.js:64
msgid "Normal"
msgstr "இயல்பானது"

#: src/effects/effects.js:65
msgid "Multiply"
msgstr "பெருக்கவும்"

#: src/effects/effects.js:66
msgid "Screen"
msgstr "திரை"

#: src/effects/effects.js:67
msgid "Overlay"
msgstr "மேலடுக்கு"

#: src/effects/effects.js:68
msgid "Darken"
msgstr "இருட்டடிப்பு"

#: src/effects/effects.js:69
msgid "Lighten"
msgstr "இலகுவாக்கு"

#: src/effects/effects.js:70
msgid "Plus darker"
msgstr "மேலும் இருண்டது"

#: src/effects/effects.js:71
msgid "Plus lighter"
msgstr "மேலும் இலகுவானது"

#: src/effects/effects.js:72
msgid "Color dodge"
msgstr "கலர் டாட்ச்"

#: src/effects/effects.js:73
msgid "Color burn"
msgstr "நிறம் எரியும்"

#: src/effects/effects.js:74
msgid "Hard light"
msgstr "கடினமான ஒளி"

#: src/effects/effects.js:75
msgid "Soft light"
msgstr "மென்மையான ஒளி"

#: src/effects/effects.js:76
msgid "Difference"
msgstr "வேறுபாடு"

#: src/effects/effects.js:77
msgid "Exclusion"
msgstr "விலக்குதல்"

#: src/effects/effects.js:78
msgid "Hue"
msgstr "வண்ணச்சாயல்"

#: src/effects/effects.js:79 src/effects/effects.js:134
msgid "Saturation"
msgstr "தெவிட்டல்"

#: src/effects/effects.js:81 src/effects/effects.js:89
msgid "Luminosity"
msgstr "ஒளிர்வு"

#: src/effects/effects.js:90
msgid "An effect that affects the luminosity of the image."
msgstr "படத்தின் ஒளிர்வை பாதிக்கும் விளைவு."

#: src/effects/effects.js:94
msgid "Shift brightness"
msgstr "பிரகாசத்தை மாற்றவும்"

#: src/effects/effects.js:95
msgid "The brightness to add or remove from the image."
msgstr ""

#: src/effects/effects.js:104
msgid "Brightness multiplier"
msgstr ""

#: src/effects/effects.js:105
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr ""

#: src/effects/effects.js:114
msgid "Contrast"
msgstr "மாறுபாடு"

#: src/effects/effects.js:115
msgid "Adjusts image contrast around the selected contrast center."
msgstr ""

#: src/effects/effects.js:124
msgid "Contrast center"
msgstr "மாறுபாடு நடுவண்"

#: src/effects/effects.js:125
msgid "The center of the contrast to use."
msgstr "பயன்படுத்த வேண்டிய மாறுபாட்டின் நடுவண்."

#: src/effects/effects.js:135
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr ""

#: src/effects/effects.js:148
msgid "Pixelize"
msgstr "பிக்சலைஸ்"

#: src/effects/effects.js:149
msgid "An effect that pixelizes the image."
msgstr "படத்தை பிக்சலைஸ் செய்யும் விளைவு."

#: src/effects/effects.js:153 src/effects/effects.js:180
#: src/effects/effects.js:207
msgid "Factor"
msgstr "காரணி"

#: src/effects/effects.js:154 src/effects/effects.js:181
msgid "How much to scale down the image."
msgstr "படத்தை எவ்வளவு குறைக்க வேண்டும்."

#: src/effects/effects.js:161 src/effects/effects.js:188
msgid "Downsampling mode"
msgstr "வீழ்ச்சி பயன்முறை"

#: src/effects/effects.js:162 src/effects/effects.js:189
msgid "The downsampling method that is used."
msgstr "பயன்படுத்தப்படும் வீழ்ச்சி முறை."

#: src/effects/effects.js:165 src/effects/effects.js:192
msgid "Boxcar"
msgstr "பாக்ச் காரர்"

#: src/effects/effects.js:166 src/effects/effects.js:193
msgid "Triangular"
msgstr "முக்கோண"

#: src/effects/effects.js:167 src/effects/effects.js:194
msgid "Dirac"
msgstr "டிராக்"

#: src/effects/effects.js:175
msgid "Downscale (advanced effect)"
msgstr "கீழ்நோக்கி (மேம்பட்ட விளைவு)"

#: src/effects/effects.js:176
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr ""

#: src/effects/effects.js:202
msgid "Upscale (advanced effect)"
msgstr "மேல்தட்டு (மேம்பட்ட விளைவு)"

#: src/effects/effects.js:203
msgid "An effect that upscales the image from the top-left corner."
msgstr "மேல்-இடது மூலையிலிருந்து படத்தை உயர்த்தும் ஒரு விளைவு."

#: src/effects/effects.js:208
msgid "How much to scale up the image."
msgstr "படத்தை எவ்வளவு அளவிட வேண்டும்."

#: src/effects/effects.js:219
msgid "Derivative"
msgstr "சார்பியம்"

#: src/effects/effects.js:220
msgid "Apply a spatial derivative, or a laplacian."
msgstr "ஒரு இடஞ்சார்ந்த வழித்தோன்றல் அல்லது ஒரு லாப்லாசியனைப் பயன்படுத்துங்கள்."

#: src/effects/effects.js:224
msgid "Operation"
msgstr "செயல்பாடு"

#: src/effects/effects.js:225
msgid "The mathematical operation to apply."
msgstr "விண்ணப்பிக்க கணித செயல்பாடு."

#: src/effects/effects.js:228
msgid "1-step derivative"
msgstr "1-படி வழித்தோன்றல்"

#: src/effects/effects.js:229
msgid "2-step derivative"
msgstr "2-படி வழித்தோன்றல்"

#: src/effects/effects.js:230
msgid "Laplacian"
msgstr "லாப்லாசியன்"

#: src/effects/effects.js:238 src/effects/effects.js:243
msgid "Noise"
msgstr "சத்தம்"

#: src/effects/effects.js:239
msgid "An effect that adds random grain to the image."
msgstr ""

#: src/effects/effects.js:244
msgid "The amount of noise to add."
msgstr "சேர்க்க வேண்டிய சத்தத்தின் அளவு."

#: src/effects/effects.js:253
msgid "Lightness"
msgstr "லேசான தன்மை"

#: src/effects/effects.js:254
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr "சத்தத்தின் ஒளிர்வு. '1.0' அமைப்பானது, விளைவை வெளிப்படையானதாக மாற்றும்."

#: src/effects/effects.js:267
msgid "Liquid Glass"
msgstr ""

#: src/effects/effects.js:268
