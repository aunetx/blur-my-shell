msgid "RGB to HSL (advanced effect)"
msgstr "RGB முதல் HSL (மேம்பட்ட விளைவு)"

#: src/effects/effects.js:392
msgid "Converts the image from RGBA color space to HSLA."
msgstr ""

#: src/effects/effects.js:399
msgid "HSL to RGB (advanced effect)"
msgstr "HSL பெறுநர் RGB (மேம்பட்ட விளைவு)"

#: src/effects/effects.js:400
msgid "Converts the image from HSLA color space to RGBA."
msgstr ""

#: src/effects/effect_groups.js:4
msgid "Blur effects"
msgstr "மங்கலான விளைவுகள்"

#: src/effects/effect_groups.js:10
msgid "Texture effects"
msgstr "அமைப்பு விளைவுகள்"

#: resources/ui/application-row.ui:4
msgid "Window Name"
msgstr "சாளரத்தின் பெயர்"

#: resources/ui/application-row.ui:8
msgid "Select window"
msgstr "சாளரத்தைத் தேர்ந்தெடுக்கவும்"

#: resources/ui/application-row.ui:9
msgid "Pick a window or select it by its classname."
msgstr "ஒரு சாளரத்தைத் தேர்ந்தெடுக்கவும் அல்லது அதன் வகுப்புப் பெயரால் தேர்ந்தெடுக்கவும்."

#: resources/ui/application-row.ui:41
msgid "Window selection failed. Make sure the extension is enabled."
msgstr ""

#: resources/ui/application-row.ui:45
msgid "The selected actor is not a window."
msgstr ""

#: resources/ui/applications.ui:5
msgid "Applications"
msgstr "பயன்பாடுகள்"

#: resources/ui/applications.ui:10
msgid "Applications blur"
msgstr "பயன்பாடுகள் மங்கலாகின்றன"

#: resources/ui/applications.ui:11
msgid "Adds blur to applications."
msgstr ""

#: resources/ui/applications.ui:20 resources/ui/dash.ui:20
#: resources/ui/panel.ui:20 resources/ui/popup.ui:20
msgid "Blur type"
msgstr "மங்கலான வகை"

#: resources/ui/applications.ui:21
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"windows. Both use the selected pipeline."
msgstr ""

#: resources/ui/applications.ui:41 resources/ui/dash.ui:41
#: resources/ui/panel.ui:41 resources/ui/popup.ui:41
msgid "Static"
msgstr "நிலையான"

#: resources/ui/applications.ui:53 resources/ui/dash.ui:53
#: resources/ui/panel.ui:53 resources/ui/popup.ui:53
msgid "Dynamic"
msgstr "மாறும்"

#: resources/ui/applications.ui:71 resources/ui/dash.ui:71
#: resources/ui/panel.ui:71 resources/ui/popup.ui:71
msgid "Corner radius"
msgstr "மூலை ஆரம்"

#: resources/ui/applications.ui:72 resources/ui/dash.ui:72
#: resources/ui/panel.ui:72
msgid "Radius for the corner rounding effect."
msgstr "மூலை ரவுண்டிங் விளைவுக்கான ஆரம்."

#: resources/ui/applications.ui:80
msgid "Enable corner rounding on maximized and fullscreen"
msgstr "பெரிதாக்கப்பட்ட மற்றும் முழுத்திரையில் மூலை ரவுண்டிங்கை இயக்கவும்"

#: resources/ui/applications.ui:81
msgid ""
"Corner rounding effect will keep being applied to maximized and fullscreen "
"windows."
msgstr ""
"கார்னர் ரவுண்டிங் எஃபெக்ட் பெரிதாக்கப்பட்ட மற்றும் முழுத்திரை சாளரங்களில் தொடர்ந்து "
"பயன்படுத்தப்படும்."

#: resources/ui/applications.ui:95
msgid "Opacity"
msgstr "ஒளிபுகாநிலை"

#: resources/ui/applications.ui:96
msgid ""
"The opacity of the window on top of the blur effect, a higher value will be "
"more legible."
msgstr ""
"மங்கலான விளைவின் மேல் உள்ள சாளரத்தின் ஒளிபுகாநிலை, அதிக மதிப்பு இன்னும் தெளிவாகத் "
"தெரியும்."

#: resources/ui/applications.ui:117
msgid "Opaque focused window"
msgstr "ஒளிபுகா மையப்படுத்தப்பட்ட சாளரம்"

#: resources/ui/applications.ui:118
msgid ""
"Makes the focused window opaque and the other ones blurred, helping with "
"legibility."
msgstr ""
"ஃபோகஸ் செய்யப்பட்ட சாளரத்தை ஒளிபுகாதாக்குகிறது மற்றும் மற்றவற்றை மங்கலாக்குகிறது, "
"தெளிவுக்கு உதவுகிறது."

#: resources/ui/applications.ui:132
msgid "Blur on overview"
msgstr "மேலோட்டப் பார்வையில் மங்கலாக்கு"

#: resources/ui/applications.ui:133
msgid ""
"Forces the blur to be properly shown on all workspaces on overview.\n"
"This may cause some latency or performance issues."
msgstr ""
"மேலோட்டத்தில் அனைத்து பணியிடங்களிலும் மங்கலானது சரியாகக் காட்டப்பட வேண்டும்.\n"
"இது சில தாமதம் அல்லது செயல்திறன் சிக்கல்களை ஏற்படுத்தலாம்."

#: resources/ui/applications.ui:148
msgid "Unblur when Fullscreen"
msgstr ""

#: resources/ui/applications.ui:149
msgid "Forces the blur to be removed when a window is in fullscreen mode."
msgstr ""

#: resources/ui/applications.ui:163
msgid "Enable all by default"
msgstr "முன்னிருப்பாக அனைத்தையும் இயக்கு"

#: resources/ui/applications.ui:164
msgid "Adds blur behind all windows by default."
msgstr "முன்னிருப்பாக அனைத்து சாளரங்களின் பின்னும் மங்கலைச் சேர்க்கிறது."

#: resources/ui/applications.ui:180
msgid "Whitelist"
msgstr "அனுமதிப்பட்டியல்"

#: resources/ui/applications.ui:181
msgid ""
"A list of windows to blur.\n"
"Use * to match any sequence of characters (e.g., Firefox* or *Code*), and ? "
"for a single one."
msgstr ""
"மங்கலாக்க வேண்டிய சாளரங்களின் பட்டியல். \n"
"எந்த எழுத்து வரிசையையும் (எ.கா., பயர்பாக்ச்* அல்லது *குறியீடு*) பொருத்த, மற்றும் ? "
"ஒருவருக்கு."

#: resources/ui/applications.ui:200 resources/ui/applications.ui:238
msgid "Add Window"
msgstr "சாளரத்தைச் சேர்க்கவும்"

#: resources/ui/applications.ui:218
msgid "Blacklist"
msgstr "பிளாக்லிஸ்ட்"

#: resources/ui/applications.ui:219
msgid ""
"A list of windows not to blur.\n"
"Use * to match any sequence of characters (e.g., Firefox* or *Code*), and ? "
"for a single one."
msgstr ""
"மங்கலாக்காத சாளரங்களின் பட்டியல். \n"
"எந்த எழுத்து வரிசையையும் (எ.கா., பயர்பாக்ச்* அல்லது *குறியீடு*) பொருத்த, மற்றும் ? "
"ஒருவருக்கு."

#: resources/ui/dash.ui:5
msgid "Dash"
msgstr "கோடு"

#: resources/ui/dash.ui:10
msgid "Dock blur"
msgstr ""

#: resources/ui/dash.ui:11
msgid ""
"Blur the background of supported dock extensions, including Dash to Dock and "
"Dhruva."
msgstr ""

#: resources/ui/dash.ui:21
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"the dash. Both use the selected pipeline."
msgstr ""

#: resources/ui/dash.ui:80 resources/ui/panel.ui:95 resources/ui/popup.ui:128
msgid "Override background"
msgstr "பின்னணியை மேலெழுதவும்"

#: resources/ui/dash.ui:81
msgid ""
"Makes the dock background transparent or semi-transparent. Disable this to "
"use the dock extension's own appearance."
msgstr ""

#: resources/ui/dash.ui:87 resources/ui/panel.ui:103 resources/ui/popup.ui:149
msgid "Background style"
