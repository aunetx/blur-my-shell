#: src/effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "تمويه كاواسي المزدوج"

#: src/effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "تمويه سريع وعالي الجودة."

#: src/effects/blur/info.js:11
msgid "Radius"
msgstr "نصف القطر"

#: src/effects/blur/info.js:12
msgid "The intensity of the blur effect."
msgstr "شدة تأثير التمويه."

#: src/effects/blur/info.js:21 src/effects/wave/info.js:77
msgid "Brightness"
msgstr "مستوى السطوع"

#: src/effects/blur/info.js:22
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr "سطوع التضبيب، تصعِّب القيم العليا قراءة النصوص."

#: src/effects/color/info.js:10 src/effects/color/info.js:15
#: src/effects/color/info.js:41 src/effects/effect_groups.js:11
msgid "Color"
msgstr "اللون"

#: src/effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "تأثير يمزج لونًا معينًا بمسار معالجة الرسوميات."

#: src/effects/color/info.js:16
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr "اللون المراد مزجه. يُضبَط مقدار المزج عبر عتامة اللون."

#: src/effects/color/info.js:21
msgid "Blend mode"
msgstr "طريقة المزج"

#: src/effects/color/info.js:22
msgid "How the color is blended in."
msgstr "كيفية مزج اللون."

#: src/effects/color/info.js:25
msgid "Normal"
msgstr "عادي"

#: src/effects/color/info.js:26
msgid "Multiply"
msgstr "ضرب"

#: src/effects/color/info.js:27
msgid "Screen"
msgstr "شاشة"

#: src/effects/color/info.js:28
msgid "Overlay"
msgstr "تراكب"

#: src/effects/color/info.js:29
msgid "Darken"
msgstr "تغميق"

#: src/effects/color/info.js:30
msgid "Lighten"
msgstr "تفتيح"

#: src/effects/color/info.js:31
msgid "Plus darker"
msgstr "زيادة التعتيم"

#: src/effects/color/info.js:32
msgid "Plus lighter"
msgstr "زيادة التفتيح"

#: src/effects/color/info.js:33
msgid "Color dodge"
msgstr "تفادي اللون"

#: src/effects/color/info.js:34
msgid "Color burn"
msgstr "حرق اللون"

#: src/effects/color/info.js:35
msgid "Hard light"
msgstr "إضاءة قوية"

#: src/effects/color/info.js:36
msgid "Soft light"
msgstr "إضاءة خافتة"

#: src/effects/color/info.js:37
msgid "Difference"
msgstr "طرح"

#: src/effects/color/info.js:38
msgid "Exclusion"
msgstr "استبعاد"

#: src/effects/color/info.js:39
msgid "Hue"
msgstr "درجة اللون"

#: src/effects/color/info.js:40 src/effects/color/info.js:93
#: src/effects/wave/info.js:67
msgid "Saturation"
msgstr "التشبع"

#: src/effects/color/info.js:42 src/effects/color/info.js:49
msgid "Luminosity"
msgstr "السطوع"

#: src/effects/color/info.js:50
msgid "An effect that affects the luminosity of the image."
msgstr "تأثير يؤثر على سطوع الصورة."

#: src/effects/color/info.js:53
msgid "Shift brightness"
msgstr "تعديل السطوع"

#: src/effects/color/info.js:54
msgid "The brightness to add or remove from the image."
msgstr "السطوع المراد إضافته إلى الصورة أو إزالته منها."

#: src/effects/color/info.js:63
msgid "Brightness multiplier"
msgstr "مُضاعِف السطوع"

#: src/effects/color/info.js:64
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr "يُضاعف سطوع الصورة؛ القيمة 0 تعني الأسود، و1 تُبقي السطوع دون تغيير."

#: src/effects/color/info.js:73
msgid "Contrast"
msgstr "التباين"

#: src/effects/color/info.js:74
msgid "Adjusts image contrast around the selected contrast center."
msgstr "يضبط تباين الصورة حول مركز التباين المحدد."

#: src/effects/color/info.js:83
msgid "Contrast center"
msgstr "مركز التباين"

#: src/effects/color/info.js:84
msgid "The center of the contrast to use."
msgstr "مركز التباين المراد استخدامه."

#: src/effects/color/info.js:94
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr "يُضاعف تشبّع الصورة؛ القيمة 0 تُزيل كل الألوان، و1 تُبقي التشبّع دون تغيير."

#: src/effects/color/info.js:106
msgid "RGB to HSL (advanced effect)"
msgstr "RGB إلى HSL (تأثير متقدم)"

#: src/effects/color/info.js:107
msgid "Converts the image from RGBA color space to HSLA."
msgstr "يُحوّل الصورة من فضاء الألوان RGBA إلى HSLA."

#: src/effects/color/info.js:112
msgid "HSL to RGB (advanced effect)"
msgstr "HSL إلى RGB (تأثير متقدم)"

#: src/effects/color/info.js:113
msgid "Converts the image from HSLA color space to RGBA."
msgstr "يُحوّل الصورة من فضاء الألوان HSLA إلى RGBA."

#: src/effects/effect_groups.js:4 resources/ui/pages/applications.ui:12
#: resources/ui/pages/shell/app-folders.ui:8
#: resources/ui/pages/shell/component.ui:8 resources/ui/pages/shell/dash.ui:8
#: resources/ui/pages/shell/overview.ui:8 resources/ui/pages/shell/panel.ui:8
#: resources/ui/pages/shell/popup.ui:8
msgid "Blur"
msgstr ""

#: src/effects/effect_groups.js:18
msgid "Texture"
msgstr ""

#: src/effects/effect_groups.js:27
msgid "Advanced"
msgstr ""

#: src/effects/effect_groups.js:28
msgid "Building blocks that are mostly useful combined with other effects."
msgstr ""

#: src/effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "الزجاج السائل"

#: src/effects/refraction/info.js:8
msgid ""
"A glossy translucent material with edge refraction, rim lighting, tint, and "
"inner shadow."
msgstr ""
"مادة شبه شفافة ولامعة مع انكسار عند الحواف، وإضاءة محيطية، وتلوين، وظل داخلي."

#: src/effects/refraction/info.js:11
msgid "Refraction scale"
msgstr "مقياس الانكسار"

#: src/effects/refraction/info.js:12
msgid "How strongly the glass bends the sampled blur texture."
msgstr "مدى شدة حني الزجاج لخامة التمويه المأخوذة."

#: src/effects/refraction/info.js:21
msgid "Blur radius"
msgstr "نصف قطر التمويه"

#: src/effects/refraction/info.js:22
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr "يُموّه الخلفية المأخوذة قبل تطبيق مُظلّل الزجاج السائل."

#: src/effects/refraction/info.js:31
msgid "Bezel width"
msgstr "عرض الإطار"

#: src/effects/refraction/info.js:32
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "مدى امتداد عدسة الزجاج السائل إلى الداخل انطلاقاً من الحافة."

#: src/effects/refraction/info.js:41
msgid "Rim spread"
msgstr "انتشار الحافة"

#: src/effects/refraction/info.js:42
msgid "How far the refraction eases inward from the glass edge."
msgstr "مدى تدرج الانكسار إلى الداخل انطلاقاً من حافة الزجاج."

#: src/effects/refraction/info.js:51
msgid "Glass thickness"
msgstr "سماكة الزجاج"

#: src/effects/refraction/info.js:52
msgid "Depth used by the refraction edge profile."
msgstr "العمق المستخدم لتوصيف حافة الانكسار."

#: src/effects/refraction/info.js:61
msgid "Refraction style"
msgstr "نمط الانكسار"

#: src/effects/refraction/info.js:62
msgid ""
"Shape of the bend near the edge. Low values bend softly, higher values bend "
"more sharply right at the edge."
msgstr ""
"شكل الانحناء بالقرب من الحافة؛ القيم المنخفضة تحنيه بنعومة، بينما القيم "
"الأعلى تحنيه بحدة أكبر عند الحافة مباشرة."

#: src/effects/refraction/info.js:71
msgid "Fresnel glare"
msgstr "وهج فرينل"

#: src/effects/refraction/info.js:72
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "شدة وهج فرينل الموجَّه المنبعث من حافة الزجاج."

#: src/effects/refraction/info.js:81
msgid "Fresnel glare angle"
msgstr "زاوية وهج فرينل"

#: src/effects/refraction/info.js:82
msgid ""
"Light direction of the fresnel glare, in degrees (0 is from above, positive "
"rotates clockwise)."
msgstr ""
"اتجاه ضوء وهج فرينل، بالدرجات (0 تعني من الأعلى، والقيم الموجبة تدور في "
"اتجاه عقارب الساعة)."

#: src/effects/refraction/info.js:91
msgid "Fresnel glare width"
msgstr "عرض وهج فرينل"

#: src/effects/refraction/info.js:92
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "مُضاعِف سَماكة حلقة وهج فرينل على طول حافة الزجاج."

#: src/effects/refraction/info.js:101
msgid "Specular glare strength"
msgstr "شدة الوهج المرآوي"

#: src/effects/refraction/info.js:102
msgid ""
"Strength of the specular glare showing the light direction (0 disables it)."
msgstr "شدة الوهج المرآوي الذي يُظهر اتجاه الضوء (القيمة 0 تُعطّله)."

#: src/effects/refraction/info.js:111
msgid "Tint strength"
msgstr "شدة التلوين"

#: src/effects/refraction/info.js:112
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr "مقدار تلوين الزجاج الحليبي الخفيف فوق خامة التمويه."

#: src/effects/refraction/info.js:121
msgid "Tint color"
msgstr "لون التلوين"

#: src/effects/refraction/info.js:122
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr "اللون الممزوج فوق خامة التمويه، موزوناً بشدة التلوين."

#: src/effects/refraction/info.js:127
msgid "Backdrop zoom"
msgstr "تقريب الخلفية"

#: src/effects/refraction/info.js:128
msgid "Zoom level of the backdrop visible through the glass."
msgstr "مستوى تقريب الخلفية الظاهرة عبر الزجاج."

#: src/effects/refraction/info.js:137
msgid "Inner shadow"
msgstr "ظل داخلي"

#: src/effects/refraction/info.js:138
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr "يُعتّم الحافة السفلية والداخلية لمنح سطح الزجاج عمقاً أكبر."

#: src/effects/refraction/info.js:147
msgid "Chromatic dispersion"
msgstr "التشتت اللوني"

#: src/effects/refraction/info.js:148
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "تشتت انكساري فيزيائي لكل قناة لونية عند حافة الزجاج."

#: src/effects/refraction/info.js:157
msgid "Edge behavior"
msgstr "سلوك الحافة"

#: src/effects/refraction/info.js:158
msgid "How texture coordinates outside the actor are sampled."
msgstr "طريقة أخذ عينات إحداثيات الخامة خارج العنصر."

#: src/effects/refraction/info.js:161
msgid "Clamp"
msgstr "تقييد"

#: src/effects/refraction/info.js:162
msgid "Mirror"
msgstr "مرآة"

#: src/effects/texture/info.js:11
msgid "Pixelize"
msgstr "بكسلة"

#: src/effects/texture/info.js:12
msgid "An effect that pixelizes the image."
msgstr "تأثير يُبكسل الصورة."

#: src/effects/texture/info.js:15 src/effects/texture/info.js:40
#: src/effects/texture/info.js:65
msgid "Factor"
msgstr "عامل"

#: src/effects/texture/info.js:16 src/effects/texture/info.js:41
msgid "How much to scale down the image."
msgstr "مقدار تصغير حجم الصورة."

#: src/effects/texture/info.js:23 src/effects/texture/info.js:48
msgid "Downsampling mode"
msgstr "وضع تقليل العينات"

#: src/effects/texture/info.js:24 src/effects/texture/info.js:49
msgid "The downsampling method that is used."
msgstr "الطريقة المستخدمة لتقليل العينات."

#: src/effects/texture/info.js:27 src/effects/texture/info.js:52
msgid "Boxcar"
msgstr "ناقلة"

#: src/effects/texture/info.js:28 src/effects/texture/info.js:53
msgid "Triangular"
msgstr "مُثَلَّثي"

#: src/effects/texture/info.js:29 src/effects/texture/info.js:54
msgid "Dirac"
msgstr "ديراك"

#: src/effects/texture/info.js:36
msgid "Downscale (advanced effect)"
msgstr "تصغير الحجم (تأثير متقدم)"

#: src/effects/texture/info.js:37
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "تأثير يُقلّص حجم الصورة ويضعها في الزاوية العلوية اليسرى."

#: src/effects/texture/info.js:61
msgid "Upscale (advanced effect)"
msgstr "تكبير (تأثير متقدم)"

#: src/effects/texture/info.js:62
msgid "An effect that upscales the image from the top-left corner."
msgstr "تأثير يُكبّر الصورة انطلاقاً من الزاوية العلوية اليسرى."

#: src/effects/texture/info.js:66
msgid "How much to scale up the image."
msgstr "مقدار تكبير الصورة."

#: src/effects/texture/info.js:76
msgid "Derivative"
msgstr "مشتق"

#: src/effects/texture/info.js:77
msgid "Apply a spatial derivative, or a laplacian."
msgstr "تطبيق مشتق مكاني، أو لابلاسي."

#: src/effects/texture/info.js:80
msgid "Operation"
msgstr "عملية"

#: src/effects/texture/info.js:81
msgid "The mathematical operation to apply."
msgstr "العملية الحسابية المراد تطبيقها."

#: src/effects/texture/info.js:84
msgid "1-step derivative"
msgstr "مشتق من الدرجة الأولى"

#: src/effects/texture/info.js:85
msgid "2-step derivative"
msgstr "مشتق من الدرجة الثانية"

#: src/effects/texture/info.js:86
msgid "Laplacian"
msgstr "لابلاسي"

#: src/effects/texture/info.js:93 src/effects/texture/info.js:97
msgid "Noise"
msgstr "ضوضاء"

#: src/effects/texture/info.js:94
msgid "An effect that adds random grain to the image."
msgstr "تأثير يُضيف حبيبات عشوائية إلى الصورة."

#: src/effects/texture/info.js:98
msgid "The amount of noise to add."
msgstr "كمية الضوضاء المطلوب اضافتها."

#: src/effects/texture/info.js:107
msgid "Lightness"
msgstr "الخفة"

#: src/effects/texture/info.js:108
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr "سطوع الضوضاء. ضبط القيمة على \"1.0\" سيجعل التأثير شفافاً."

#: src/effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "موجة بخارية"

#: src/effects/wave/info.js:8
msgid ""
"A flowing wave displacement for a lively and dynamic feel with natural "
"movement."
msgstr "إزاحة موجية متدفقة تمنح طابعاً حيوياً وديناميكياً بحركة طبيعية."

#: src/effects/wave/info.js:11
msgid "Wave frequency"
msgstr "تردد الموجة"

#: src/effects/wave/info.js:12
msgid "How tightly packed the ripples are."
msgstr "مدى تقارب التموجات."

#: src/effects/wave/info.js:21
msgid "Wave amplitude"
msgstr "سَعة الموجة"

#: src/effects/wave/info.js:22
msgid "How strongly the image gets displaced by the waves."
msgstr "مدى شدة إزاحة الصورة بفعل الأمواج."

#: src/effects/wave/info.js:31
msgid "Wave octaves"
msgstr "أوكتافات الموجة"

#: src/effects/wave/info.js:32
msgid ""
"Detail level of the wave shape. Higher adds more detail at the cost of "
"performance."
msgstr "مستوى تفاصيل شكل الموجة؛ القيم الأعلى تزيد التفاصيل على حساب الأداء."

#: src/effects/wave/info.js:39
msgid "Vapor octaves"
msgstr "أوكتافات البخار"

#: src/effects/wave/info.js:40
msgid ""
"Detail level of the misty texture. Higher adds more detail at the cost of "
"performance."
msgstr ""
"مستوى تفاصيل الخامة الضبابية؛ القيم الأعلى تزيد التفاصيل على حساب الأداء."

#: src/effects/wave/info.js:47
msgid "Vapor speed"
msgstr "سرعة البخار"

#: src/effects/wave/info.js:48
msgid "How quickly the misty vapor texture drifts over time."
msgstr "مدى سرعة انجراف خامة البخار الضبابي بمرور الوقت."

#: src/effects/wave/info.js:57
msgid "Texture grain"
msgstr "حبيبات الخامة"

#: src/effects/wave/info.js:58
msgid "Adds a fine sandblasted texture to the image."
msgstr "يُضيف خامة مُرمَّلة دقيقة إلى الصورة."

#: src/effects/wave/info.js:68
msgid "The saturation of the effect."
msgstr "إشباع التأثير."

#: src/effects/wave/info.js:78
msgid "The brightness of the effect."
msgstr "سطوع التأثير."

#: src/effects/wave/info.js:87
msgid "Zoom"
msgstr "التقريب"

#: src/effects/wave/info.js:88
msgid "Magnifies the backdrop toward the surface's center."
msgstr "يُكبّر الخلفية باتجاه مركز السطح."

#: src/effects/wave/info.js:97
msgid "Dispersion"
msgstr "التشتت"

#: src/effects/wave/info.js:98
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "شدة الزيغ اللوني لإضفاء طابع خلل بصري."

#: src/effects/wave/info.js:107
msgid "Enable flow animation"
msgstr "تفعيل حركة التدفق"

#: src/effects/wave/info.js:108
msgid "Whether the wave noise continuously flows over time."
msgstr "ما إذا كان ضجيج الموجة يتدفق باستمرار بمرور الوقت."

#: src/effects/wave/info.js:112
msgid "Flow animation speed"
msgstr "سرعة حركة التدفق"

#: src/effects/wave/info.js:113
msgid "The base speed at which the wave pattern flows."
msgstr "السرعة الأساسية لتدفق نمط الموجة."

#: src/effects/wave/info.js:122
msgid "Resize ease duration"
msgstr "مدة سلاسة تغيير الحجم"

#: src/effects/wave/info.js:123
msgid ""
"How long the effect takes to adjust when a window changes size "
"(milliseconds)."
msgstr ""
"المدة التي يستغرقها التأثير للتكيّف عند تغيير حجم النافذة (بالمللي ثانية)."

#: resources/ui/menu.ui:6
msgid "Debug Logging"
msgstr ""

#: resources/ui/menu.ui:10
msgid "Reset Preferences…"
msgstr ""

#: resources/ui/menu.ui:16
msgid "Project page"
msgstr "صفحة المشروع"

#: resources/ui/menu.ui:20
msgid "Report a Bug"
msgstr "بلِّغ عن علَّة"

#: resources/ui/menu.ui:24
msgid "License"
msgstr "الترخيص"

#: resources/ui/menu.ui:28
msgid "Donate"
msgstr "تبرَّع"

#: resources/ui/menu.ui:45
msgid "Main Menu"
msgstr ""

#: resources/ui/pages/applications.ui:5
#: src/preferences/pages/pipelines/pipeline_page.js:34
msgid "Applications"
msgstr "التطبيقات"

#: resources/ui/pages/applications.ui:13
msgid "Adds blur to applications."
msgstr ""

#: resources/ui/pages/applications.ui:23
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"windows. Both use the selected pipeline."
msgstr ""

#: resources/ui/pages/applications.ui:38
#: resources/ui/pages/shell/overview.ui:27 resources/ui/pages/shell/panel.ui:42
msgid "Appearance"
msgstr ""

#: resources/ui/pages/applications.ui:43
msgid "Opacity"
msgstr "الشفافية"

#: resources/ui/pages/applications.ui:44
msgid ""
"The opacity of the window on top of the blur effect, a higher value will be "
"more legible."
msgstr ""
"درجة شفافية النافذة فوق تأثير التضبيب, القيم الأعلى ستؤدي إلى وضوح أكبر."

#: resources/ui/pages/applications.ui:64
msgid "Opaque focused window"
msgstr "كَمَد (لاشفافية) النافذة المحددة"

#: resources/ui/pages/applications.ui:65
msgid ""
"Makes the focused window opaque and the other ones blurred, helping with "
"legibility."
msgstr ""
"يجعل النافذة المحددة لا شفافة و الباقي مموه، مما يساعد على زيادة إمكانية "
"القراءة."

#: resources/ui/pages/applications.ui:71 resources/ui/pages/shell/panel.ui:47
#: resources/ui/pages/shell/popup.ui:65
msgid "Corner radius"
msgstr "نصف قطر الزوايا"

#: resources/ui/pages/applications.ui:72 resources/ui/pages/shell/panel.ui:48
msgid "Radius for the corner rounding effect."
msgstr "نصف القطر لتأثير استدارة الزوايا."

#: resources/ui/pages/applications.ui:79 resources/ui/pages/shell/panel.ui:55
#: resources/ui/pages/shell/popup.ui:71
