#~ msgid "Disables the transparency of the panel when a window is near it."
#~ msgstr ""
#~ "Desativa a transparência do painel quando uma janela está perto dele."

#~ msgid "A list of windows to blur."
#~ msgstr "Uma lista de janelas para desfocar."

#~ msgid "A list of windows not to blur."
#~ msgstr "Uma lista de janelas para não desfocar."

