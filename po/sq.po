#: src/effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "Mjegullim Dual Kawase"

#: src/effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "Një mjegullim i shpejtë dhe me cilësi të lartë."

#: src/effects/blur/info.js:11
msgid "Radius"
msgstr "Rrezja"

#: src/effects/blur/info.js:12
msgid "The intensity of the blur effect."
msgstr "Intensiteti i efektit të mjegullimit."

#: src/effects/blur/info.js:21 src/effects/wave/info.js:77
msgid "Brightness"
msgstr "Ndriçimi"

#: src/effects/blur/info.js:22
msgid "The brightness of the blur effect, a high value might make the text harder to read."
msgstr "Ndriçimi i efektit të mjegullimit; një vlerë e lartë mund ta bëjë tekstin më të vështirë për t'u lexuar."

#: src/effects/color/info.js:10 src/effects/color/info.js:15
#: src/effects/color/info.js:41 src/effects/effect_groups.js:11
msgid "Color"
msgstr "Ngjyra"

#: src/effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "Një efekt që përzien një ngjyrë në zinxhir."

#: src/effects/color/info.js:16
msgid "The color to blend in. The blending amount is controlled by the opacity of the color."
msgstr "Ngjyra që përzihet. Sasia e përzierjes kontrollohet nga patejdukshmëria e ngjyrës."

#: src/effects/color/info.js:21
msgid "Blend mode"
msgstr "Mënyra e përzierjes"

#: src/effects/color/info.js:22
msgid "How the color is blended in."
msgstr "Si përzihet ngjyra."

#: src/effects/color/info.js:25
msgid "Normal"
msgstr "Normale"

#: src/effects/color/info.js:26
msgid "Multiply"
msgstr "Shumëzim"

#: src/effects/color/info.js:27
msgid "Screen"
msgstr "Ekran"

#: src/effects/color/info.js:28
msgid "Overlay"
msgstr "Mbivendosje"

#: src/effects/color/info.js:29
msgid "Darken"
msgstr "Errësim"

#: src/effects/color/info.js:30
msgid "Lighten"
msgstr "Ndriçim"

#: src/effects/color/info.js:31
msgid "Plus darker"
msgstr "Më e errët"

#: src/effects/color/info.js:32
msgid "Plus lighter"
msgstr "Më e çelët"

#: src/effects/color/info.js:33
msgid "Color dodge"
msgstr "Shmangie ngjyre"

#: src/effects/color/info.js:34
msgid "Color burn"
msgstr "Djegie ngjyre"

#: src/effects/color/info.js:35
msgid "Hard light"
msgstr "Dritë e fortë"

#: src/effects/color/info.js:36
msgid "Soft light"
msgstr "Dritë e butë"

#: src/effects/color/info.js:37
msgid "Difference"
msgstr "Diferencë"

#: src/effects/color/info.js:38
msgid "Exclusion"
msgstr "Përjashtim"

#: src/effects/color/info.js:39
msgid "Hue"
msgstr "Nuancë"

#: src/effects/color/info.js:40 src/effects/color/info.js:93
#: src/effects/wave/info.js:67
msgid "Saturation"
msgstr "Ngopje"

#: src/effects/color/info.js:42 src/effects/color/info.js:49
msgid "Luminosity"
msgstr "Shkëlqim"

#: src/effects/color/info.js:50
msgid "An effect that affects the luminosity of the image."
msgstr "Një efekt që ndikon në shkëlqimin e figurës."

#: src/effects/color/info.js:53
msgid "Shift brightness"
msgstr "Zhvendos ndriçimin"

#: src/effects/color/info.js:54
msgid "The brightness to add or remove from the image."
msgstr "Ndriçimi që i shtohet ose i hiqet figurës."

#: src/effects/color/info.js:63
msgid "Brightness multiplier"
msgstr "Shumëzuesi i ndriçimit"

#: src/effects/color/info.js:64
msgid "Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr "Shumëzon ndriçimin e figurës; 0 është e zezë dhe 1 e lë ndriçimin të pandryshuar."

#: src/effects/color/info.js:73
msgid "Contrast"
msgstr "Kontrasti"

#: src/effects/color/info.js:74
msgid "Adjusts image contrast around the selected contrast center."
msgstr "Rregullon kontrastin e figurës rreth qendrës së zgjedhur të kontrastit."

#: src/effects/color/info.js:83
msgid "Contrast center"
msgstr "Qendra e kontrastit"

#: src/effects/color/info.js:84
msgid "The center of the contrast to use."
msgstr "Qendra e kontrastit që përdoret."

#: src/effects/color/info.js:94
msgid "Multiplies image saturation; 0 removes all color and 1 leaves saturation unchanged."
msgstr "Shumëzon ngopjen e figurës; 0 heq të gjitha ngjyrat dhe 1 e lë ngopjen të pandryshuar."

#: src/effects/color/info.js:106
msgid "RGB to HSL (advanced effect)"
msgstr "RGB në HSL (efekt i avancuar)"

#: src/effects/color/info.js:107
msgid "Converts the image from RGBA color space to HSLA."
msgstr "E kthen figurën nga hapësira e ngjyrave RGBA në HSLA."

#: src/effects/color/info.js:112
msgid "HSL to RGB (advanced effect)"
msgstr "HSL në RGB (efekt i avancuar)"

#: src/effects/color/info.js:113
msgid "Converts the image from HSLA color space to RGBA."
msgstr "E kthen figurën nga hapësira e ngjyrave HSLA në RGBA."

#: src/effects/effect_groups.js:4 resources/ui/pages/applications.ui:12
#: resources/ui/pages/shell/app-folders.ui:8
#: resources/ui/pages/shell/component.ui:8 resources/ui/pages/shell/dash.ui:8
#: resources/ui/pages/shell/overview.ui:8 resources/ui/pages/shell/panel.ui:8
#: resources/ui/pages/shell/popup.ui:8
msgid "Blur"
msgstr "Mjegullim"

#: src/effects/effect_groups.js:18
msgid "Texture"
msgstr "Teksturë"

#: src/effects/effect_groups.js:27
msgid "Advanced"
msgstr "Të avancuara"

#: src/effects/effect_groups.js:28
msgid "Building blocks that are mostly useful combined with other effects."
msgstr "Pjesë ndërtimi, të dobishme kryesisht kur kombinohen me efekte të tjera."

#: src/effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "Xham i lëngshëm"

#: src/effects/refraction/info.js:8
msgid "A glossy translucent material with edge refraction, rim lighting, tint, and inner shadow."
msgstr "Një material i shndritshëm e i tejdukshëm, me thyerje drite në skaje, ndriçim të buzës, ngjyrim dhe hije të brendshme."

#: src/effects/refraction/info.js:11
msgid "Refraction scale"
msgstr "Shkalla e thyerjes"

#: src/effects/refraction/info.js:12
msgid "How strongly the glass bends the sampled blur texture."
msgstr "Sa fort e përkul xhami teksturën e mjegulluar."

#: src/effects/refraction/info.js:21
msgid "Blur radius"
msgstr "Rrezja e mjegullimit"

#: src/effects/refraction/info.js:22
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr "Mjegullon sfondin para se të zbatohet efekti i xhamit të lëngshëm."

#: src/effects/refraction/info.js:31
msgid "Bezel width"
msgstr "Gjerësia e kornizës"

#: src/effects/refraction/info.js:32
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "Sa larg brenda nga skaji shtrihet thjerrëza e xhamit të lëngshëm."

#: src/effects/refraction/info.js:41
msgid "Rim spread"
msgstr "Shtrirja e buzës"

#: src/effects/refraction/info.js:42
msgid "How far the refraction eases inward from the glass edge."
msgstr "Sa larg brenda nga skaji i xhamit zbutet thyerja e dritës."

#: src/effects/refraction/info.js:51
msgid "Glass thickness"
msgstr "Trashësia e xhamit"

#: src/effects/refraction/info.js:52
msgid "Depth used by the refraction edge profile."
msgstr "Thellësia që përdor profili i thyerjes në skaj."

#: src/effects/refraction/info.js:61
msgid "Refraction style"
msgstr "Stili i thyerjes"

#: src/effects/refraction/info.js:62
msgid "Shape of the bend near the edge. Low values bend softly, higher values bend more sharply right at the edge."
msgstr "Forma e përkuljes pranë skajit. Vlerat e ulëta përkulin butë, vlerat më të larta përkulin më fort pikërisht në skaj."

#: src/effects/refraction/info.js:71
msgid "Fresnel glare"
msgstr "Shkëlqimi Fresnel"

#: src/effects/refraction/info.js:72
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "Fuqia e shkëlqimit të drejtuar Fresnel nga skaji i xhamit."

#: src/effects/refraction/info.js:81
msgid "Fresnel glare angle"
msgstr "Këndi i shkëlqimit Fresnel"

#: src/effects/refraction/info.js:82
msgid "Light direction of the fresnel glare, in degrees (0 is from above, positive rotates clockwise)."
msgstr "Drejtimi i dritës së shkëlqimit Fresnel, në gradë (0 është nga lart, vlerat pozitive rrotullojnë sipas akrepave të orës)."

#: src/effects/refraction/info.js:91
msgid "Fresnel glare width"
msgstr "Gjerësia e shkëlqimit Fresnel"

#: src/effects/refraction/info.js:92
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "Shumëzuesi i trashësisë së unazës së shkëlqimit Fresnel përgjatë skajit të xhamit."

#: src/effects/refraction/info.js:101
msgid "Specular glare strength"
msgstr "Fuqia e shkëlqimit pasqyrues"

#: src/effects/refraction/info.js:102
msgid "Strength of the specular glare showing the light direction (0 disables it)."
msgstr "Fuqia e shkëlqimit pasqyrues që tregon drejtimin e dritës (0 e çaktivizon)."

#: src/effects/refraction/info.js:111
msgid "Tint strength"
msgstr "Fuqia e ngjyrimit"

#: src/effects/refraction/info.js:112
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr "Sasia e një ngjyrimi të lehtë qumështor xhami mbi teksturën e mjegulluar."

#: src/effects/refraction/info.js:121
msgid "Tint color"
msgstr "Ngjyra e ngjyrimit"

#: src/effects/refraction/info.js:122
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr "Ngjyra që përzihet mbi teksturën e mjegulluar, sipas fuqisë së ngjyrimit."

#: src/effects/refraction/info.js:127
msgid "Backdrop zoom"
msgstr "Zmadhimi i sfondit"

#: src/effects/refraction/info.js:128
msgid "Zoom level of the backdrop visible through the glass."
msgstr "Niveli i zmadhimit të sfondit që duket përmes xhamit."

#: src/effects/refraction/info.js:137
msgid "Inner shadow"
msgstr "Hija e brendshme"

#: src/effects/refraction/info.js:138
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr "Errëson skajin e poshtëm dhe të brendshëm për një sipërfaqe xhami më të thellë."

#: src/effects/refraction/info.js:147
msgid "Chromatic dispersion"
msgstr "Shpërndarja kromatike"

#: src/effects/refraction/info.js:148
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "Shpërndarje fizike e thyerjes së dritës për çdo kanal në skajin e xhamit."

#: src/effects/refraction/info.js:157
msgid "Edge behavior"
msgstr "Sjellja në skaje"

#: src/effects/refraction/info.js:158
msgid "How texture coordinates outside the actor are sampled."
msgstr "Si merren mostrat për koordinatat e teksturës jashtë aktorit."

#: src/effects/refraction/info.js:161
msgid "Clamp"
msgstr "Kufizim"

#: src/effects/refraction/info.js:162
msgid "Mirror"
msgstr "Pasqyrim"

#: src/effects/texture/info.js:11
msgid "Pixelize"
msgstr "Pikselizim"

#: src/effects/texture/info.js:12
msgid "An effect that pixelizes the image."
msgstr "Një efekt që e pikselizon figurën."

#: src/effects/texture/info.js:15 src/effects/texture/info.js:40
#: src/effects/texture/info.js:65
msgid "Factor"
msgstr "Faktori"

#: src/effects/texture/info.js:16 src/effects/texture/info.js:41
msgid "How much to scale down the image."
msgstr "Sa të zvogëlohet figura."

#: src/effects/texture/info.js:23 src/effects/texture/info.js:48
msgid "Downsampling mode"
msgstr "Mënyra e zvogëlimit"

#: src/effects/texture/info.js:24 src/effects/texture/info.js:49
msgid "The downsampling method that is used."
msgstr "Metoda e zvogëlimit që përdoret."

#: src/effects/texture/info.js:27 src/effects/texture/info.js:52
msgid "Boxcar"
msgstr "Kuti"

#: src/effects/texture/info.js:28 src/effects/texture/info.js:53
msgid "Triangular"
msgstr "Trekëndësh"

#: src/effects/texture/info.js:29 src/effects/texture/info.js:54
msgid "Dirac"
msgstr "Dirac"

#: src/effects/texture/info.js:36
msgid "Downscale (advanced effect)"
msgstr "Zvogëlim (efekt i avancuar)"

#: src/effects/texture/info.js:37
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "Një efekt që e zvogëlon figurën dhe e vendos në këndin lart majtas."

#: src/effects/texture/info.js:61
msgid "Upscale (advanced effect)"
msgstr "Zmadhim (efekt i avancuar)"

#: src/effects/texture/info.js:62
msgid "An effect that upscales the image from the top-left corner."
msgstr "Një efekt që e zmadhon figurën nga këndi lart majtas."

#: src/effects/texture/info.js:66
msgid "How much to scale up the image."
msgstr "Sa të zmadhohet figura."

#: src/effects/texture/info.js:76
msgid "Derivative"
msgstr "Derivati"

#: src/effects/texture/info.js:77
msgid "Apply a spatial derivative, or a laplacian."
msgstr "Zbaton një derivat hapësinor ose një laplacian."

#: src/effects/texture/info.js:80
msgid "Operation"
msgstr "Veprimi"

#: src/effects/texture/info.js:81
msgid "The mathematical operation to apply."
msgstr "Veprimi matematik që zbatohet."

#: src/effects/texture/info.js:84
msgid "1-step derivative"
msgstr "Derivat me 1 hap"

#: src/effects/texture/info.js:85
msgid "2-step derivative"
msgstr "Derivat me 2 hapa"

#: src/effects/texture/info.js:86
msgid "Laplacian"
msgstr "Laplacian"

#: src/effects/texture/info.js:93 src/effects/texture/info.js:97
msgid "Noise"
msgstr "Zhurma"

#: src/effects/texture/info.js:94
msgid "An effect that adds random grain to the image."
msgstr "Një efekt që i shton figurës kokrriza të rastësishme."

#: src/effects/texture/info.js:98
msgid "The amount of noise to add."
msgstr "Sasia e zhurmës që shtohet."

#: src/effects/texture/info.js:107
msgid "Lightness"
msgstr "Çeltësia"

#: src/effects/texture/info.js:108
msgid "The luminosity of the noise. A setting of '1.0' will make the effect transparent."
msgstr "Shkëlqimi i zhurmës. Vlera '1.0' e bën efektin të tejdukshëm."

#: src/effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "Vapor Wave"

#: src/effects/wave/info.js:8
msgid "A flowing wave displacement for a lively and dynamic feel with natural movement."
msgstr "Një zhvendosje me valë që rrjedhin, për një ndjesi të gjallë dhe dinamike me lëvizje natyrale."

#: src/effects/wave/info.js:11
msgid "Wave frequency"
msgstr "Frekuenca e valëve"

#: src/effects/wave/info.js:12
msgid "How tightly packed the ripples are."
msgstr "Sa të dendura janë valëzimet."

#: src/effects/wave/info.js:21
msgid "Wave amplitude"
msgstr "Amplituda e valëve"

#: src/effects/wave/info.js:22
msgid "How strongly the image gets displaced by the waves."
msgstr "Sa fort e zhvendosin valët figurën."

#: src/effects/wave/info.js:31
msgid "Wave octaves"
msgstr "Oktavat e valëve"

#: src/effects/wave/info.js:32
msgid "Detail level of the wave shape. Higher adds more detail at the cost of performance."
msgstr "Niveli i detajeve të formës së valës. Vlerat më të larta shtojnë detaje në kurriz të shpejtësisë."

#: src/effects/wave/info.js:39
msgid "Vapor octaves"
msgstr "Oktavat e avullit"

#: src/effects/wave/info.js:40
msgid "Detail level of the misty texture. Higher adds more detail at the cost of performance."
msgstr "Niveli i detajeve të teksturës së mjegullt. Vlerat më të larta shtojnë detaje në kurriz të shpejtësisë."

#: src/effects/wave/info.js:47
msgid "Vapor speed"
msgstr "Shpejtësia e avullit"

#: src/effects/wave/info.js:48
msgid "How quickly the misty vapor texture drifts over time."
msgstr "Sa shpejt lëviz me kohën tekstura e mjegullt e avullit."

#: src/effects/wave/info.js:57
msgid "Texture grain"
msgstr "Kokrrizat e teksturës"

#: src/effects/wave/info.js:58
msgid "Adds a fine sandblasted texture to the image."
msgstr "I shton figurës një teksturë të imët kokrrizore, si xham i mat."

#: src/effects/wave/info.js:68
msgid "The saturation of the effect."
msgstr "Ngopja e efektit."

#: src/effects/wave/info.js:78
msgid "The brightness of the effect."
msgstr "Ndriçimi i efektit."

#: src/effects/wave/info.js:87
msgid "Zoom"
msgstr "Zmadhimi"

#: src/effects/wave/info.js:88
msgid "Magnifies the backdrop toward the surface's center."
msgstr "E zmadhon sfondin drejt qendrës së sipërfaqes."

#: src/effects/wave/info.js:97
msgid "Dispersion"
msgstr "Shpërndarja"

#: src/effects/wave/info.js:98
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "Fuqia e aberacionit kromatik, për një pamje si me defekt."

#: src/effects/wave/info.js:107
msgid "Enable flow animation"
msgstr "Aktivizo animacionin e rrjedhjes"

#: src/effects/wave/info.js:108
msgid "Whether the wave noise continuously flows over time."
msgstr "Nëse zhurma e valëve rrjedh vazhdimisht me kohën."

#: src/effects/wave/info.js:112
msgid "Flow animation speed"
msgstr "Shpejtësia e animacionit të rrjedhjes"

#: src/effects/wave/info.js:113
msgid "The base speed at which the wave pattern flows."
msgstr "Shpejtësia bazë me të cilën rrjedh modeli i valëve."

#: src/effects/wave/info.js:122
msgid "Resize ease duration"
msgstr "Kohëzgjatja e përshtatjes së madhësisë"

#: src/effects/wave/info.js:123
msgid "How long the effect takes to adjust when a window changes size (milliseconds)."
msgstr "Sa kohë i duhet efektit të përshtatet kur një dritare ndryshon madhësi (milisekonda)."

#: resources/ui/menu.ui:6
msgid "Debug Logging"
msgstr "Regjistrim për diagnostikim"

#: resources/ui/menu.ui:10
msgid "Disable on Power Saver"
msgstr "Çaktivizo gjatë kursimit të energjisë"

#: resources/ui/menu.ui:14
msgid "Reset Preferences…"
msgstr "Rikthe parapëlqimet…"

#: resources/ui/menu.ui:20
msgid "Project page"
msgstr "Faqja e projektit"

#: resources/ui/menu.ui:24
msgid "Report a Bug"
msgstr "Raporto një gabim"

#: resources/ui/menu.ui:28
msgid "License"
msgstr "Licenca"

#: resources/ui/menu.ui:38
msgid "Main Menu"
msgstr "Menuja kryesore"

#: resources/ui/pages/applications.ui:5
#: src/preferences/pages/pipelines/components.js:16
msgid "Applications"
msgstr "Aplikacionet"

#: resources/ui/pages/applications.ui:36
#: resources/ui/pages/shell/overview.ui:26 resources/ui/pages/shell/panel.ui:39
msgid "Appearance"
msgstr "Pamja"

#: resources/ui/pages/applications.ui:41
msgid "Opacity"
msgstr "Patejdukshmëria"

#: resources/ui/pages/applications.ui:42
msgid "Higher values are easier to read"
msgstr "Me vlera më të larta teksti lexohet më lehtë"

#: resources/ui/pages/applications.ui:62
msgid "Opaque focused window"
msgstr "Dritarja aktive e patejdukshme"

#: resources/ui/pages/applications.ui:68 resources/ui/pages/shell/panel.ui:44
#: resources/ui/pages/shell/popup.ui:61
msgid "Corner radius"
msgstr "Rrezja e qosheve"

#: resources/ui/pages/applications.ui:75 resources/ui/pages/shell/panel.ui:51
#: resources/ui/pages/shell/popup.ui:66
msgid "Rounded corners"
msgstr "Qoshet e rrumbullakuara"

#: resources/ui/pages/applications.ui:82
msgid "Round maximized and fullscreen windows"
msgstr "Rrumbullako dritaret e maksimizuara dhe në ekran të plotë"

#: resources/ui/pages/applications.ui:90
msgid "Behavior"
msgstr "Sjellja"

#: resources/ui/pages/applications.ui:95
msgid "Blur on overview"
msgstr "Mjegullim në përmbledhje"

#: resources/ui/pages/applications.ui:96
msgid "Shows the blur on every workspace, at some performance cost"
msgstr "Shfaq mjegullimin në çdo hapësirë pune, me njëfarë kostoje në performancë"

#: resources/ui/pages/applications.ui:102
msgid "Unblur when Fullscreen"
msgstr "Hiq mjegullimin në ekran të plotë"

#: resources/ui/pages/applications.ui:108
msgid "Blur all windows"
msgstr "Mjegullo të gjitha dritaret"

#: resources/ui/pages/applications.ui:109
msgid "When off, only the windows listed below are blurred."
msgstr "Kur është çaktivizuar, mjegullohen vetëm dritaret e listuara më poshtë."

#: resources/ui/pages/applications.ui:117
msgid "Blurred windows"
msgstr "Dritaret e mjegulluara"

#: resources/ui/pages/applications.ui:118
#: resources/ui/pages/applications.ui:140
msgid "Use * to match any characters, like Firefox* or *Code*, and ? to match a single one."
msgstr "Përdor * për çdo varg shkronjash, si Firefox* ose *Code*, dhe ? për një shkronjë të vetme."

#: resources/ui/pages/applications.ui:126
#: resources/ui/pages/applications.ui:148
msgid "Add Window"
msgstr "Shto dritare"

#: resources/ui/pages/applications.ui:139
msgid "Excluded windows"
msgstr "Dritaret e përjashtuara"

#: resources/ui/pages/applications.ui:162 resources/ui/pages/shell/panel.ui:150
#: resources/ui/pages/shell/popup.ui:160
msgid "All"
