msgid "Blur radius"
msgstr ""

#: src/effects/effects.js:283
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr ""

#: src/effects/effects.js:292
msgid "Bezel width"
msgstr ""

#: src/effects/effects.js:293
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr ""

#: src/effects/effects.js:302
msgid "Rim spread"
msgstr ""

#: src/effects/effects.js:303
msgid "How far the refraction eases inward from the glass edge."
msgstr ""

#: src/effects/effects.js:312
msgid "Glass thickness"
msgstr ""

#: src/effects/effects.js:313
msgid "Depth used by the Snell-style refraction profile."
msgstr ""

#: src/effects/effects.js:322
msgid "Fresnel glare"
msgstr ""

#: src/effects/effects.js:323
msgid "Strength of the Schlick fresnel rim glare from the glass edge."
msgstr ""

#: src/effects/effects.js:332
msgid "Tint strength"
msgstr ""

#: src/effects/effects.js:333
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr ""

#: src/effects/effects.js:342
msgid "Tint color"
msgstr ""

#: src/effects/effects.js:343
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr ""

#: src/effects/effects.js:348
msgid "Backdrop zoom"
msgstr ""

#: src/effects/effects.js:349
msgid "Zoom level of the backdrop visible through the glass."
msgstr ""

#: src/effects/effects.js:358
msgid "Inner shadow"
msgstr ""

#: src/effects/effects.js:359
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr ""

#: src/effects/effects.js:368
msgid "Chromatic dispersion"
msgstr ""

#: src/effects/effects.js:369
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr ""

#: src/effects/effects.js:378
msgid "Edge behavior"
msgstr ""

#: src/effects/effects.js:379
msgid "How texture coordinates outside the actor are sampled."
msgstr ""

#: src/effects/effects.js:382
msgid "Clamp"
msgstr ""

#: src/effects/effects.js:383
msgid "Mirror"
msgstr ""

