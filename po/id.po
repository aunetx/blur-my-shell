#: src/effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "Blur Dual Kawase"

#: src/effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "Efek blur yang cepat dan berkualitas tinggi."

#: src/effects/blur/info.js:12
msgid "Radius"
msgstr "Radius"

#: src/effects/blur/info.js:13
msgid "The intensity of the blur effect."
msgstr "Intensitas efek keburaman."

#: src/effects/blur/info.js:22 src/effects/wave/info.js:78
msgid "Brightness"
msgstr "Kecerahan"

#: src/effects/blur/info.js:23
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr ""
"Kecerahan efek buram, nilai tinggi mungkin membuat teks lebih sulit dibaca."

#: src/effects/color/info.js:10 src/effects/color/info.js:16
#: src/effects/color/info.js:42
msgid "Color"
msgstr "Warna"

#: src/effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "Efek yang memadukan warna ke dalam pipa."

#: src/effects/color/info.js:17
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr ""
"Warna yang akan dicampurkan. Tingkat pencampuran ditentukan oleh opasitas "
"warna."

#: src/effects/color/info.js:22
msgid "Blend mode"
msgstr "Mode campuran"

#: src/effects/color/info.js:23
msgid "How the color is blended in."
msgstr "Cara warna dicampurkan."

#: src/effects/color/info.js:26
msgid "Normal"
msgstr "Normal"

#: src/effects/color/info.js:27
msgid "Multiply"
msgstr "Kalikan"

#: src/effects/color/info.js:28
msgid "Screen"
msgstr "Layar"

#: src/effects/color/info.js:29
msgid "Overlay"
msgstr "Hamparan"

#: src/effects/color/info.js:30
msgid "Darken"
msgstr "Gelapkan"

#: src/effects/color/info.js:31
msgid "Lighten"
msgstr "Terangkan"

#: src/effects/color/info.js:32
msgid "Plus darker"
msgstr "Plus lebih gelap"

#: src/effects/color/info.js:33
msgid "Plus lighter"
msgstr "Plus lebih terang"

#: src/effects/color/info.js:34
msgid "Color dodge"
msgstr "Dodge warna"

#: src/effects/color/info.js:35
msgid "Color burn"
msgstr "Bakar warna"

#: src/effects/color/info.js:36
msgid "Hard light"
msgstr "Cahaya keras"

#: src/effects/color/info.js:37
msgid "Soft light"
msgstr "Cahaya lembut"

#: src/effects/color/info.js:38
msgid "Difference"
msgstr "Perbedaan"

#: src/effects/color/info.js:39
msgid "Exclusion"
msgstr "Pengecualian"

#: src/effects/color/info.js:40
msgid "Hue"
msgstr "Rona"

#: src/effects/color/info.js:41 src/effects/color/info.js:95
#: src/effects/wave/info.js:68
msgid "Saturation"
msgstr "Saturasi"

#: src/effects/color/info.js:43 src/effects/color/info.js:50
msgid "Luminosity"
msgstr "Luminositas"

#: src/effects/color/info.js:51
msgid "An effect that affects the luminosity of the image."
msgstr "Efek yang memengaruhi luminositas gambar."

#: src/effects/color/info.js:55
msgid "Shift brightness"
msgstr "Geser kecerahan"

#: src/effects/color/info.js:56
msgid "The brightness to add or remove from the image."
msgstr "Kecerahan yang akan ditambahkan atau dikurangi dari gambar."

#: src/effects/color/info.js:65
msgid "Brightness multiplier"
msgstr "Pengali kecerahan"

#: src/effects/color/info.js:66
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr ""
"Mengalikan kecerahan gambar; 0 menghasilkan warna hitam dan 1 mempertahankan "
"kecerahan."

#: src/effects/color/info.js:75
msgid "Contrast"
msgstr "Kontras"

#: src/effects/color/info.js:76
msgid "Adjusts image contrast around the selected contrast center."
msgstr ""
"Menyesuaikan kontras gambar berdasarkan titik tengah kontras yang dipilih."

#: src/effects/color/info.js:85
msgid "Contrast center"
msgstr "Titik tengah kontras"

#: src/effects/color/info.js:86
msgid "The center of the contrast to use."
msgstr "Titik tengah kontras yang digunakan."

#: src/effects/color/info.js:96
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr ""
"Mengalikan saturasi gambar; 0 menghilangkan semua warna dan 1 mempertahankan "
"saturasi."

#: src/effects/color/info.js:108
msgid "RGB to HSL (advanced effect)"
msgstr "RGB ke HSL (efek lanjutan)"

#: src/effects/color/info.js:109
msgid "Converts the image from RGBA color space to HSLA."
msgstr "Mengonversi gambar dari ruang warna RGBA ke HSLA."

#: src/effects/color/info.js:115
msgid "HSL to RGB (advanced effect)"
msgstr "HSL ke RGB (efek lanjutan)"

#: src/effects/color/info.js:116
msgid "Converts the image from HSLA color space to RGBA."
msgstr "Mengonversi gambar dari ruang warna HSLA ke RGBA."

#: src/effects/effect_groups.js:4
msgid "Blur effects"
msgstr "Efek buram"

#: src/effects/effect_groups.js:10
msgid "Texture effects"
msgstr "Efek tekstur"

#: src/effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "Kaca Cair"

#: src/effects/refraction/info.js:8
msgid ""
"A glossy translucent material with edge refraction, rim lighting, tint, and "
"inner shadow."
msgstr ""
"Material mengilap dan tembus cahaya dengan refraksi tepi, pencahayaan tepi, "
"rona warna, dan bayangan dalam."

#: src/effects/refraction/info.js:12
msgid "Refraction scale"
msgstr "Skala refraksi"

#: src/effects/refraction/info.js:13
msgid "How strongly the glass bends the sampled blur texture."
msgstr "Seberapa kuat kaca membelokkan tekstur blur yang disampel."

#: src/effects/refraction/info.js:22
msgid "Blur radius"
msgstr "Radius blur"

#: src/effects/refraction/info.js:23
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr ""
"Memburamkan latar belakang yang disampel sebelum shader kaca cair diterapkan."

#: src/effects/refraction/info.js:32
msgid "Bezel width"
msgstr "Lebar bezel"

#: src/effects/refraction/info.js:33
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "Seberapa jauh lensa kaca cair menjangkau ke dalam dari tepi."

#: src/effects/refraction/info.js:42
msgid "Rim spread"
msgstr "Sebaran tepi"

#: src/effects/refraction/info.js:43
msgid "How far the refraction eases inward from the glass edge."
msgstr "Seberapa jauh refraksi berangsur melemah ke dalam dari tepi kaca."

#: src/effects/refraction/info.js:52
msgid "Glass thickness"
msgstr "Ketebalan kaca"

#: src/effects/refraction/info.js:53
msgid "Depth used by the refraction edge profile."
msgstr "Kedalaman yang digunakan oleh profil refraksi tepi."

#: src/effects/refraction/info.js:62
msgid "Refraction style"
msgstr "Gaya refraksi"

#: src/effects/refraction/info.js:63
msgid ""
"Shape of the bend near the edge. Low values bend softly, higher values bend "
"more sharply right at the edge."
msgstr ""
"Bentuk pembelokan di dekat tepi. Nilai rendah menghasilkan pembelokan yang "
"lembut, sedangkan nilai lebih tinggi menghasilkan pembelokan yang lebih "
"tajam tepat di tepi."

#: src/effects/refraction/info.js:72
msgid "Fresnel glare"
msgstr "Kilau Fresnel"

#: src/effects/refraction/info.js:73
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "Intensitas kilau Fresnel berarah dari tepi kaca."

#: src/effects/refraction/info.js:82
msgid "Fresnel glare angle"
msgstr "Sudut kilau Fresnel"

#: src/effects/refraction/info.js:83
msgid ""
"Light direction of the fresnel glare, in degrees (0 is from above, positive "
"rotates clockwise)."
msgstr ""
"Arah cahaya kilau Fresnel, dalam derajat (0 berarti dari atas, nilai positif "
"memutar searah jarum jam)."

#: src/effects/refraction/info.js:92
msgid "Fresnel glare width"
msgstr "Lebar kilau Fresnel"

#: src/effects/refraction/info.js:93
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "Pengali ketebalan cincin kilau Fresnel di sepanjang tepi kaca."

#: src/effects/refraction/info.js:102
msgid "Specular glare strength"
msgstr "Intensitas kilau spekular"

#: src/effects/refraction/info.js:103
msgid ""
"Strength of the specular glare showing the light direction (0 disables it)."
msgstr ""
"Intensitas kilau spekular yang menunjukkan arah cahaya (0 menonaktifkannya)."

#: src/effects/refraction/info.js:112
msgid "Tint strength"
msgstr "Intensitas rona warna"

#: src/effects/refraction/info.js:113
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr ""
"Tingkat rona kaca putih susu yang lembut di atas tekstur yang diburamkan."

#: src/effects/refraction/info.js:122
msgid "Tint color"
msgstr "Warna rona"

#: src/effects/refraction/info.js:123
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr ""
"Warna yang dicampurkan di atas tekstur yang diburamkan, dengan bobot sesuai "
"intensitas rona warna."

#: src/effects/refraction/info.js:128
msgid "Backdrop zoom"
msgstr "Zoom latar belakang"

#: src/effects/refraction/info.js:129
msgid "Zoom level of the backdrop visible through the glass."
msgstr "Tingkat zoom latar belakang yang terlihat melalui kaca."

#: src/effects/refraction/info.js:138
msgid "Inner shadow"
msgstr "Bayangan dalam"

#: src/effects/refraction/info.js:139
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr ""
"Menggelapkan tepi bawah dan bagian dalam agar permukaan kaca tampak lebih "
"dalam."

#: src/effects/refraction/info.js:148
msgid "Chromatic dispersion"
msgstr "Dispersi kromatik"

#: src/effects/refraction/info.js:149
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "Dispersi refraksi fisik per kanal warna di tepi kaca."

#: src/effects/refraction/info.js:158
msgid "Edge behavior"
msgstr "Perilaku tepi"

#: src/effects/refraction/info.js:159
msgid "How texture coordinates outside the actor are sampled."
msgstr "Cara pengambilan sampel koordinat tekstur di luar aktor."

#: src/effects/refraction/info.js:162
msgid "Clamp"
msgstr "Jepit"

#: src/effects/refraction/info.js:163
msgid "Mirror"
msgstr "Cerminkan"

#: src/effects/texture/info.js:11
msgid "Pixelize"
msgstr "Pixelize"

#: src/effects/texture/info.js:12
msgid "An effect that pixelizes the image."
msgstr "Efek yang membuat piksel gambar."

#: src/effects/texture/info.js:16 src/effects/texture/info.js:42
#: src/effects/texture/info.js:68
msgid "Factor"
msgstr "Faktor"

#: src/effects/texture/info.js:17 src/effects/texture/info.js:43
msgid "How much to scale down the image."
msgstr "Seberapa besar untuk mengecilkan gambar."

#: src/effects/texture/info.js:24 src/effects/texture/info.js:50
msgid "Downsampling mode"
msgstr "Mode downsampling"

#: src/effects/texture/info.js:25 src/effects/texture/info.js:51
msgid "The downsampling method that is used."
msgstr "Metode downsampling yang digunakan."

#: src/effects/texture/info.js:28 src/effects/texture/info.js:54
msgid "Boxcar"
msgstr "Boxcar"

#: src/effects/texture/info.js:29 src/effects/texture/info.js:55
msgid "Triangular"
msgstr "Triangular"

#: src/effects/texture/info.js:30 src/effects/texture/info.js:56
msgid "Dirac"
msgstr "Dirac"

#: src/effects/texture/info.js:37
msgid "Downscale (advanced effect)"
msgstr "Downscale (efek lanjutan)"

#: src/effects/texture/info.js:38
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "Efek yang memperkecil gambar dan menempatkannya di sudut kiri atas."

#: src/effects/texture/info.js:63
msgid "Upscale (advanced effect)"
msgstr "Upscale (efek lanjutan)"

#: src/effects/texture/info.js:64
msgid "An effect that upscales the image from the top-left corner."
msgstr "Efek yang memperbesar gambar dari pojok kiri atas."

#: src/effects/texture/info.js:69
msgid "How much to scale up the image."
msgstr "Seberapa besar untuk memperbesar gambar."

#: src/effects/texture/info.js:79
msgid "Derivative"
msgstr "Turunan"

#: src/effects/texture/info.js:80
msgid "Apply a spatial derivative, or a laplacian."
msgstr "Menerapkan turunan spasial atau laplasian."

#: src/effects/texture/info.js:84
msgid "Operation"
msgstr "Operasi"

#: src/effects/texture/info.js:85
msgid "The mathematical operation to apply."
msgstr "Operasi matematis yang akan diterapkan."

#: src/effects/texture/info.js:88
msgid "1-step derivative"
msgstr "Turunan 1 langkah"

#: src/effects/texture/info.js:89
msgid "2-step derivative"
msgstr "Turunan 2 langkah"

#: src/effects/texture/info.js:90
msgid "Laplacian"
msgstr "Laplacian"

#: src/effects/texture/info.js:97 src/effects/texture/info.js:102
msgid "Noise"
msgstr "Noise"

#: src/effects/texture/info.js:98
msgid "An effect that adds random grain to the image."
msgstr "Efek yang menambahkan butiran acak pada gambar."

#: src/effects/texture/info.js:103
msgid "The amount of noise to add."
msgstr "Jumlah noise yang akan ditambahkan."

#: src/effects/texture/info.js:112
msgid "Lightness"
msgstr "Kecerahan"

#: src/effects/texture/info.js:113
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr ""
"Tingkat kecerahan noise. Pengaturan ‘1.0’ akan membuat efek menjadi "
"transparan."

#: src/effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "Gelombang Uap"

#: src/effects/wave/info.js:8
msgid ""
"A flowing wave displacement for a lively and dynamic feel with natural "
"movement."
msgstr ""
"Pergeseran bergelombang yang mengalir untuk menghadirkan kesan hidup dan "
"dinamis dengan gerakan alami."

#: src/effects/wave/info.js:12
msgid "Wave frequency"
msgstr "Frekuensi gelombang"

#: src/effects/wave/info.js:13
msgid "How tightly packed the ripples are."
msgstr "Seberapa rapat riak gelombang tersusun."

#: src/effects/wave/info.js:22
msgid "Wave amplitude"
msgstr "Amplitudo gelombang"

#: src/effects/wave/info.js:23
msgid "How strongly the image gets displaced by the waves."
msgstr "Seberapa kuat gelombang menggeser gambar."

#: src/effects/wave/info.js:32
msgid "Wave octaves"
msgstr "Oktaf gelombang"

#: src/effects/wave/info.js:33
msgid ""
"Detail level of the wave shape. Higher adds more detail at the cost of "
"performance."
msgstr ""
"Tingkat detail bentuk gelombang. Nilai yang lebih tinggi menambah detail, "
"tetapi mengurangi kinerja."

#: src/effects/wave/info.js:40
msgid "Vapor octaves"
msgstr "Oktaf uap"

#: src/effects/wave/info.js:41
msgid ""
"Detail level of the misty texture. Higher adds more detail at the cost of "
"performance."
msgstr ""
"Tingkat detail tekstur kabut. Nilai yang lebih tinggi menambah detail, "
"tetapi mengurangi kinerja."

#: src/effects/wave/info.js:48
msgid "Vapor speed"
msgstr "Kecepatan uap"

#: src/effects/wave/info.js:49
msgid "How quickly the misty vapor texture drifts over time."
msgstr "Seberapa cepat tekstur uap berkabut bergerak seiring waktu."

#: src/effects/wave/info.js:58
msgid "Texture grain"
msgstr "Butiran tekstur"

#: src/effects/wave/info.js:59
msgid "Adds a fine sandblasted texture to the image."
msgstr "Menambahkan tekstur halus seperti hasil sandblasting pada gambar."

#: src/effects/wave/info.js:69
msgid "The saturation of the effect."
msgstr "Saturasi efek."

#: src/effects/wave/info.js:79
msgid "The brightness of the effect."
msgstr "Kecerahan efek."

#: src/effects/wave/info.js:88
msgid "Zoom"
msgstr "Zoom"

#: src/effects/wave/info.js:89
msgid "Magnifies the backdrop toward the surface's center."
msgstr "Memperbesar latar belakang ke arah pusat permukaan."

#: src/effects/wave/info.js:98
msgid "Dispersion"
msgstr "Dispersi"

#: src/effects/wave/info.js:99
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "Intensitas aberasi kromatik untuk menghasilkan kesan glitch."

#: src/effects/wave/info.js:108
msgid "Enable flow animation"
msgstr "Aktifkan animasi aliran"

#: src/effects/wave/info.js:109
msgid "Whether the wave noise continuously flows over time."
msgstr "Menentukan apakah noise gelombang terus mengalir seiring waktu."

#: src/effects/wave/info.js:113
msgid "Flow animation speed"
msgstr "Kecepatan animasi aliran"

#: src/effects/wave/info.js:114
msgid "The base speed at which the wave pattern flows."
msgstr "Kecepatan dasar aliran pola gelombang."

#: src/effects/wave/info.js:123
msgid "Resize ease duration"
msgstr "Durasi transisi perubahan ukuran"

#: src/effects/wave/info.js:124
msgid ""
"How long the effect takes to adjust when a window changes size "
"(milliseconds)."
msgstr ""
"Waktu yang diperlukan efek untuk menyesuaikan diri saat ukuran jendela "
"berubah (milidetik)."

#: resources/ui/application-row.ui:4
msgid "Window Name"
msgstr "Nama jendela"

#: resources/ui/application-row.ui:8
msgid "Select window"
msgstr "Pilih jendela"

#: resources/ui/application-row.ui:9
msgid "Pick a window or select it by its classname."
msgstr "Pilih jendela atau pilih berdasarkan nama kelasnya."

#: resources/ui/application-row.ui:41
msgid "Window selection failed. Make sure the extension is enabled."
msgstr "Pemilihan jendela gagal. Pastikan ekstensi diaktifkan."

#: resources/ui/application-row.ui:45
msgid "The selected actor is not a window."
msgstr "Aktor yang dipilih bukan jendela."

#: resources/ui/applications.ui:5
msgid "Applications"
msgstr "Aplikasi"

#: resources/ui/applications.ui:10
msgid "Applications blur"
msgstr "Blur aplikasi"

#: resources/ui/applications.ui:11
msgid "Adds blur to applications."
msgstr "Menambahkan efek blur pada aplikasi."

#: resources/ui/applications.ui:20 resources/ui/dash.ui:20
#: resources/ui/panel.ui:20 resources/ui/popup.ui:20
msgid "Blur type"
msgstr "Jenis blur"

#: resources/ui/applications.ui:21
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"windows. Both use the selected pipeline."
msgstr ""
"Blur statis mengikuti wallpaper; blur dinamis mengambil sampel konten "
"langsung di belakang jendela. Keduanya menggunakan pipeline yang dipilih."

#: resources/ui/applications.ui:41 resources/ui/dash.ui:41
#: resources/ui/panel.ui:41 resources/ui/popup.ui:41
msgid "Static"
msgstr "Statis"

#: resources/ui/applications.ui:53 resources/ui/dash.ui:53
#: resources/ui/panel.ui:53 resources/ui/popup.ui:53
msgid "Dynamic"
msgstr "Dinamis"

#: resources/ui/applications.ui:71 resources/ui/panel.ui:71
#: resources/ui/popup.ui:71
msgid "Corner radius"
msgstr "Jari-jari sudut"

#: resources/ui/applications.ui:72 resources/ui/panel.ui:72
msgid "Radius for the corner rounding effect."
msgstr "Jari-jari untuk efek pembulatan sudut."

#: resources/ui/applications.ui:80 resources/ui/panel.ui:80
#: resources/ui/popup.ui:161
msgid "Rounded corners"
msgstr "Sudut membulat"

#: resources/ui/applications.ui:85 resources/ui/panel.ui:85
#: resources/ui/popup.ui:166
msgid "All"
msgstr "Semua"

#: resources/ui/applications.ui:86 resources/ui/panel.ui:86
#: resources/ui/popup.ui:167
msgid "Top only"
msgstr "Hanya bagian atas"

#: resources/ui/applications.ui:87 resources/ui/panel.ui:87
#: resources/ui/popup.ui:168
msgid "Bottom only"
msgstr "Hanya bagian bawah"

#: resources/ui/applications.ui:88 resources/ui/panel.ui:88
#: resources/ui/popup.ui:169
msgid "None"
msgstr "Tidak ada"

#: resources/ui/applications.ui:97
msgid "Round maximized and fullscreen windows"
msgstr "Bulatkan sudut jendela yang dimaksimalkan dan dalam mode layar penuh"

#: resources/ui/applications.ui:98
msgid ""
"Corner rounding effect will keep being applied to maximized and fullscreen "
"windows."
msgstr ""
"Efek pembulatan sudut akan tetap diterapkan pada jendela yang dimaksimalkan "
"dan layar penuh."

#: resources/ui/applications.ui:112
msgid "Opacity"
msgstr "Kegelapan"

#: resources/ui/applications.ui:113
msgid ""
"The opacity of the window on top of the blur effect, a higher value will be "
"more legible."
msgstr ""
"Kegelapan jendela di atas efek kabur, nilai yang lebih tinggi akan lebih "
"mudah dilihat."

#: resources/ui/applications.ui:134
msgid "Opaque focused window"
msgstr "Jendela fokus buram"

#: resources/ui/applications.ui:135
msgid ""
"Makes the focused window opaque and the other ones blurred, helping with "
"legibility."
msgstr ""
"Membuat jendela yang sedang aktif menjadi buram dan jendela lainnya menjadi "
"transparan, membantu meningkatkan keterbacaan."

#: resources/ui/applications.ui:149
msgid "Blur on overview"
msgstr "Blur pada ruang kerja"

#: resources/ui/applications.ui:150
msgid ""
"Forces the blur to be properly shown on all workspaces on overview.\n"
"This may cause some latency or performance issues."
msgstr ""
"Memaksa blurnya untuk ditampilkan dengan benar pada semua ruang kerja pada "
"semua ruang kerja.\n"
"Ini dapat menyebabkan beberapa latensi atau masalah kinerja."

#: resources/ui/applications.ui:165
msgid "Unblur when Fullscreen"
msgstr "Nonaktifkan blur saat layar penuh"

#: resources/ui/applications.ui:166
msgid "Forces the blur to be removed when a window is in fullscreen mode."
msgstr ""
"Memaksa penghapusan efek blur saat jendela berada dalam mode layar penuh."

#: resources/ui/applications.ui:180
msgid "Enable all by default"
msgstr "Aktifkan semua secara bawaan"

#: resources/ui/applications.ui:181
msgid "Adds blur behind all windows by default."
msgstr "Menambahkan efek blur di belakang semua jendela secara default."

#: resources/ui/applications.ui:197
msgid "Whitelist"
msgstr "Daftar putih"

#: resources/ui/applications.ui:198
msgid ""
"A list of windows to blur.\n"
"Use * to match any sequence of characters (e.g., Firefox* or *Code*), and ? "
"for a single one."
msgstr ""
"Daftar jendela yang akan diburamkan.\n"
"Gunakan * untuk mencocokkan urutan karakter apa pun (mis., Firefox* atau "
"*Code*), dan ? untuk satu karakter."

#: resources/ui/applications.ui:217 resources/ui/applications.ui:255
