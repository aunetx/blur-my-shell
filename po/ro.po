#~ msgid "Dash to Dock blur"
#~ msgstr "Estompare Dash to Dock"

#~ msgid "Blur the background of the Dash to Dock extension, if it is used."
#~ msgstr ""
#~ "Estompează fundalul extensiei Dash to Dock, dacă aceasta este utilizată."

#~ msgid ""
#~ "Makes the background either transparent or semi-transparent, disable this "
#~ "to use Dash to Dock preferences instead."
#~ msgstr ""
#~ "Face fundalul fie transparent, fie semitransparent, dezactivează asta "
#~ "pentru a folosi în schimb preferințele Dash to Dock."

#~ msgid "Disables the blur from Dash to Dock when entering the overview."
#~ msgstr "Dezactivează estomparea din Dash to Dock când se intră în vedere."

#~ msgid ""
#~ "The color to blend in. The blending amount is controled by the opacity of "
#~ "the color."
#~ msgstr ""
#~ "Culoarea pentru îmbinare. Măsura îmbinării este controlată de opacitatea "
#~ "culorii."

#~ msgid ""
#~ "An effect that downscales the image and put it on the top-left corner."
#~ msgstr ""
#~ "Un efect care micșorează imaginea și o pune în colțul din stânga-sus."

#~ msgid "Converts the image from RGBA colorspace to HSLA."
#~ msgstr "Convertește imaginea de la spațiul de culoare RGBA la HSLA."

#~ msgid "Converts the image from HSLA colorspace to RGBA."
#~ msgstr "Convertește imaginea de la spațiul de culoare HSLA la RGBA."

#~ msgid "Shape effects"
#~ msgstr "Efecte de formă"

#~ msgid "Native gaussian blur"
#~ msgstr "Estomparea gaussiană nativă"

#~ msgid ""
#~ "An optimized blur effect that smoothly blends pixels within a given "
#~ "radius."
#~ msgstr ""
#~ "Un efect de estompare optimizat care estompează ușor pixelii pe o anumită "
#~ "rază."

#~ msgid "Gaussian blur (advanced effect)"
#~ msgstr "Estompare gaussiană (efect avansat)"

#~ msgid ""
#~ "A blur effect that smoothly blends pixels within a given radius. This "
#~ "effect is more precise, but way less optimized."
#~ msgstr ""
#~ "Un efect de estompare care estompează ușor pixelii pe o anumită rază. "
#~ "Acest efect este mai precis, dar mult mai puțin optimizat."

#~ msgid ""
#~ "The intensity of the blur effect. The bigger it is, the slower it will be."
#~ msgstr ""
#~ "Intensitatea efectului de estompare. Cu cât este mai mare, cu atât va fi "
#~ "mai lent."

#~ msgid "Monte Carlo blur"
#~ msgstr "Estomparea Monte Carlo"

#~ msgid ""
#~ "A blur effect that mimics a random walk, by picking pixels further and "
#~ "further away from its origin and mixing them all together."
#~ msgstr ""
#~ "Un efect de estompare care imită o mișcare aleatorie, prin alegerea unor "
#~ "pixeli din ce în ce mai îndepărtați de la originea sa și amestecarea lor."

#~ msgid ""
#~ "The maximum travel distance for each step in the random walk. A higher "
#~ "value will make the blur more randomized."
#~ msgstr ""
#~ "Distanța maximă de deplasare pentru fiecare pas din procesul de deplasare "
#~ "aleatorie. O valoare mai mare va face ca neclaritatea să fie mai "
#~ "aleatorie."

#~ msgid "Iterations"
#~ msgstr "Iterații"

#~ msgid ""
#~ "The number of iterations. The more there are, the smoother the blur is."
#~ msgstr ""
#~ "Numărul de iterații. Cu cât sunt mai multe, cu atât este mai uniformă "
#~ "neclaritatea."

#~ msgid "Use base pixel"
#~ msgstr "Folosire pixel de bază"

#~ msgid ""
#~ "Whether or not the original pixel is counted for the blur. If it is, the "
#~ "image will be more legible."
#~ msgstr ""
#~ "Dacă pixelul original este inclus în estompare sau nu. Dacă este, atunci "
#~ "imaginea va deveni mai lizibilă."

#~ msgid "Corner"
#~ msgstr "Colț"

#~ msgid ""
#~ "An effect that draws corners. Add it last not to have the other effects "
#~ "perturb the corners."
#~ msgstr ""
#~ "Un efect care desenează colțuri. Adaugă-l ultimul pentru ca celelalte "
#~ "efecte să nu perturbe colțurile."

#~ msgid ""
#~ "The radius of the corner. GNOME apps use a radius of 12 px by default."
#~ msgstr "Raza colțului. Aplicațiile GNOME folosesc implicit o rază de 12 px."

#~ msgid "Top corners"
#~ msgstr "Colțuri de sus"

#~ msgid "Whether or not to round the top corners."
#~ msgstr "Dacă să se rotunjească sau nu colțurile de sus."

#~ msgid "Bottom corners"
#~ msgstr "Colțuri de jos"

#~ msgid "Whether or not to round the bottom corners."
#~ msgstr "Dacă să se rotunjească sau nu colțurile de jos."

#~ msgid ""
#~ "Adds blur to the applications.\n"
#~ "To get the best results possible, although with reduced performances, you "
#~ "can choose the option “No artifact” in the “Other → Hack level” tab."
#~ msgstr ""
#~ "Adaugă estompare la aplicație.\n"
#~ "Pentru a obține cele mai bune rezultate, totuși cu performanță redusă, "
#~ "poți alege opțiunea „Fără artefacte” din fila „Altele → Nivel hack”."

#~ msgid ""
#~ "The dynamic blur is slower and only compatible with a gaussian blur "
#~ "effect."
#~ msgstr ""
#~ "Estomparea dinamică este mai lentă și este compatibilă doar cu un efect "
#~ "de estomparea gaussian."

#~ msgid "A list of windows to blur."
#~ msgstr "Lista ferestrelor ce vor fi blurate."

#~ msgid "A list of windows not to blur."
#~ msgstr "Lista ferestrelor ce nu vor fi blurate."

#~ msgid "Gaussian blur"
#~ msgstr "Estomparea gaussiană"

#~ msgid "Applications blur (beta)"
#~ msgstr "Blur Aplicații (beta)"

#~ msgid ""
#~ "Adds blur to the applications. This is still beta functionality.\n"
#~ "To get the best results possible, make sure to choose the option “No "
#~ "artifact” in the “General → Hack level” preference.\n"
#~ "        "
#~ msgstr ""
#~ "Adaugă blur aplicațiilor. Această funcție este înca in beta. \n"
#~ "Pentru a obține cele mai bune rezultate posibile, selectează \"Fară "
#~ "artefacte\" în \"General -> Hack level\"\n"
#~ "        "

#~ msgid ""
#~ "Adds blur behind all windows by default.\n"
#~ "Not recommended because of performance and stability issues."
#~ msgstr ""
#~ "Adaugă blur în spatele tuturor ferstrelor.\n"
#~ "Nu este recomandat deoarece poate cauza probleme de stabilitate și "
#~ "performanță."

#~ msgid "Customize properties"
#~ msgstr "Personalizează proprietățiile"

#~ msgid ""
#~ "Uses customized blur properties, instead of the ones set in the General "
#~ "page."
#~ msgstr ""
#~ "Utilizează proprietățile de estompare personalizate, în locul celor "
#~ "setate în pagina General."

#~ msgid ""
#~ "Changes the color of the blur. The opacity of the color controls how much "
#~ "it is blended into the blur effect."
#~ msgstr ""
#~ "Schimbă culoarea efectului de blur. Opacitatea culorii controlează cat de "
#~ "mult este amestecată cu efectul de blur."

#~ msgid "Noise amount"
#~ msgstr "Nivelul de zgomot"

#~ msgid ""
#~ "The amount of noise to add to the blur effect, useful on low-contrast "
#~ "screens or for aesthetic purpose."
#~ msgstr ""
#~ "Nivelul de zgomot care se adaugă la efectul de estompare, util pe "
#~ "ecranele cu contrast redus sau în scop estetic."

#~ msgid "Noise lightness"
#~ msgstr "Gradul de luminozitate a zgomotului"

#~ msgid "The lightness of the noise added to the blur effect."
#~ msgstr ""
#~ "Gradul de luminozitate al zgomotului sporește efectul de neclaritate."

#~ msgid "Notice"
#~ msgstr "Notă"

#~ msgid ""
#~ "Noise and color can't be activated on dynamically blurred components, "
#~ "such as this one."
#~ msgstr ""
#~ "Zgomotul și culoarea nu pot fi activate pe componentele estompate "
#~ "dinamic, cum ar fi aceasta."
