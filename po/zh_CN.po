#: resources/ui/pages/applications.ui:5
#: src/preferences/pages/pipelines/components.js:16
msgid "Applications"
msgstr "应用程序"

#: resources/ui/pages/applications.ui:13
msgid "Adds blur to applications."
msgstr "为应用程序添加模糊。"

#: resources/ui/pages/applications.ui:23
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"windows. Both use the selected pipeline."
msgstr "静态模糊跟随壁纸；动态模糊采样窗口后面的实时内容。两者均使用所选管线。"

#: resources/ui/pages/applications.ui:38
#: resources/ui/pages/shell/overview.ui:27 resources/ui/pages/shell/panel.ui:42
msgid "Appearance"
msgstr ""

#: resources/ui/pages/applications.ui:43
msgid "Opacity"
msgstr "不透明度"

#: resources/ui/pages/applications.ui:44
msgid ""
"The opacity of the window on top of the blur effect, a higher value will be "
"more legible."
msgstr "窗口的不透明度放在模糊效果之上，值越高越清晰。"

#: resources/ui/pages/applications.ui:64
msgid "Opaque focused window"
msgstr "使焦点窗口不透明"

#: resources/ui/pages/applications.ui:65
msgid ""
"Makes the focused window opaque and the other ones blurred, helping with "
"legibility."
msgstr "使焦点窗口不透明而模糊其他窗口，以提高易读性。"

#: resources/ui/pages/applications.ui:71 resources/ui/pages/shell/panel.ui:47
#: resources/ui/pages/shell/popup.ui:65
msgid "Corner radius"
msgstr "圆角半径"

#: resources/ui/pages/applications.ui:72 resources/ui/pages/shell/panel.ui:48
msgid "Radius for the corner rounding effect."
msgstr "圆角效果的半径。"

#: resources/ui/pages/applications.ui:79 resources/ui/pages/shell/panel.ui:55
#: resources/ui/pages/shell/popup.ui:71
msgid "Rounded corners"
msgstr "圆角"

#: resources/ui/pages/applications.ui:86
msgid "Round maximized and fullscreen windows"
msgstr "圆角化最大化和全屏窗口"

#: resources/ui/pages/applications.ui:87
msgid ""
"Corner rounding effect will keep being applied to maximized and fullscreen "
"windows."
msgstr "圆角效果将持续作用于最大化和全屏窗口。"

#: resources/ui/pages/applications.ui:95
msgid "Behavior"
msgstr ""

#: resources/ui/pages/applications.ui:100
msgid "Blur on overview"
msgstr "在概览中模糊"

#: resources/ui/pages/applications.ui:101
msgid ""
"Forces the blur to be properly shown on all workspaces on overview.\n"
"This may cause some latency or performance issues."
msgstr ""
"强制模糊在概览中正确显示在所有工作区上。\n"
"这可能会导致延迟或性能问题。"

#: resources/ui/pages/applications.ui:108
msgid "Unblur when Fullscreen"
msgstr "全屏时取消模糊"

#: resources/ui/pages/applications.ui:109
msgid "Forces the blur to be removed when a window is in fullscreen mode."
msgstr "当窗口处于全屏模式时强制移除模糊。"

#: resources/ui/pages/applications.ui:115
msgid "Blur all windows"
msgstr ""

#: resources/ui/pages/applications.ui:116
msgid "When off, only the windows listed below are blurred."
msgstr ""

#: resources/ui/pages/applications.ui:124
msgid "Blurred windows"
msgstr ""

#: resources/ui/pages/applications.ui:125
msgid ""
"Only these windows are blurred. Use * to match any sequence of characters "
"(e.g., Firefox* or *Code*), and ? for a single one."
msgstr ""

#: resources/ui/pages/applications.ui:133
#: resources/ui/pages/applications.ui:155
msgid "Add Window"
msgstr "添加窗口"

#: resources/ui/pages/applications.ui:146
msgid "Excluded windows"
msgstr ""

#: resources/ui/pages/applications.ui:147
msgid ""
"These windows are never blurred. Use * to match any sequence of characters "
"(e.g., Firefox* or *Code*), and ? for a single one."
msgstr ""

