#: src/effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "雙重 Kawase 模糊"

#: src/effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "一種快速、高品質的模糊效果。"

#: src/effects/blur/info.js:11
msgid "Radius"
msgstr "半徑"

#: src/effects/blur/info.js:12
msgid "The intensity of the blur effect."
msgstr "模糊效果的強度。"

#: src/effects/blur/info.js:21 src/effects/wave/info.js:77
msgid "Brightness"
msgstr "亮度"

#: src/effects/blur/info.js:22
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr "模糊效果的亮度，數值越高文字越難閱讀。"

#: src/effects/color/info.js:10 src/effects/color/info.js:15
#: src/effects/color/info.js:41 src/effects/effect_groups.js:11
#: src/effects/texture/info.js:51
msgid "Color"
msgstr "顏色"

#: src/effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "一個將顏色混進管線(pipeline)的效果。"

#: src/effects/color/info.js:16
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr "要融入的顏色。混合量由顏色的不透明度控制。"

#: src/effects/color/info.js:21 src/effects/texture/info.js:31
msgid "Blend mode"
msgstr "混合模式"

#: src/effects/color/info.js:22
msgid "How the color is blended in."
msgstr "顏色的混合方式。"

#: src/effects/color/info.js:25 src/effects/texture/info.js:35
#: resources/ui/pages/applications.ui:42
#: resources/ui/pages/shell/app-folders.ui:28
#: resources/ui/pages/shell/component.ui:28 resources/ui/pages/shell/dash.ui:44
#: resources/ui/pages/shell/overview.ui:28 resources/ui/pages/shell/panel.ui:45
#: resources/ui/pages/shell/popup.ui:46
msgid "Normal"
msgstr "預設"

#: src/effects/color/info.js:26 src/effects/texture/info.js:36
msgid "Multiply"
msgstr "正片疊底"

#: src/effects/color/info.js:27 src/effects/texture/info.js:37
msgid "Screen"
msgstr "濾色"

#: src/effects/color/info.js:28 src/effects/texture/info.js:38
msgid "Overlay"
msgstr "疊加"

#: src/effects/color/info.js:29 src/effects/texture/info.js:39
msgid "Darken"
msgstr "變暗"

#: src/effects/color/info.js:30 src/effects/texture/info.js:40
msgid "Lighten"
msgstr "變亮"

#: src/effects/color/info.js:31 src/effects/texture/info.js:41
msgid "Plus darker"
msgstr "相加變暗"

#: src/effects/color/info.js:32 src/effects/texture/info.js:42
msgid "Plus lighter"
msgstr "相加變亮"

#: src/effects/color/info.js:33 src/effects/texture/info.js:43
msgid "Color dodge"
msgstr "顏色減淡"

#: src/effects/color/info.js:34 src/effects/texture/info.js:44
msgid "Color burn"
msgstr "顏色加深"

#: src/effects/color/info.js:35 src/effects/texture/info.js:45
msgid "Hard light"
msgstr "強光"

#: src/effects/color/info.js:36 src/effects/texture/info.js:46
msgid "Soft light"
msgstr "柔光"

#: src/effects/color/info.js:37 src/effects/texture/info.js:47
msgid "Difference"
msgstr "差值"

#: src/effects/color/info.js:38 src/effects/texture/info.js:48
msgid "Exclusion"
msgstr "排除"

#: src/effects/color/info.js:39 src/effects/texture/info.js:49
msgid "Hue"
msgstr "色相"

#: src/effects/color/info.js:40 src/effects/color/info.js:93
#: src/effects/texture/info.js:50 src/effects/wave/info.js:67
msgid "Saturation"
msgstr "飽和度"

#: src/effects/color/info.js:42 src/effects/color/info.js:49
#: src/effects/texture/info.js:52
msgid "Luminosity"
msgstr "亮度"

#: src/effects/color/info.js:50
msgid "An effect that affects the luminosity of the image."
msgstr "影響圖片亮度的效果。"

#: src/effects/color/info.js:53
msgid "Shift brightness"
msgstr "偏移亮度"

#: src/effects/color/info.js:54
msgid "The brightness to add or remove from the image."
msgstr "要為圖片增加或減少的亮度值。"

#: src/effects/color/info.js:63
msgid "Brightness multiplier"
msgstr "亮度乘數"

#: src/effects/color/info.js:64
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr "與圖片亮度相乘；0 為純黑，1 保持亮度不變。"

#: src/effects/color/info.js:73
msgid "Contrast"
msgstr "對比度"

#: src/effects/color/info.js:74
msgid "Adjusts image contrast around the selected contrast center."
msgstr "圍繞所選對比度中心調整圖片對比度。"

#: src/effects/color/info.js:83
msgid "Contrast center"
msgstr "對比度中心"

#: src/effects/color/info.js:84
msgid "The center of the contrast to use."
msgstr "要使用的對比度中心。"

#: src/effects/color/info.js:94
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr "與圖片飽和度相乘；0 去除所有顏色，1 保持飽和度不變。"

#: src/effects/color/info.js:106
msgid "RGB to HSL (advanced effect)"
msgstr "RGB 轉 HSL (進階效果)"

#: src/effects/color/info.js:107
msgid "Converts the image from RGBA color space to HSLA."
msgstr "將圖片從 RGBA 色彩空間轉換為 HSLA。"

#: src/effects/color/info.js:112
msgid "HSL to RGB (advanced effect)"
msgstr "HSL 轉 RGB (進階效果)"

#: src/effects/color/info.js:113
msgid "Converts the image from HSLA color space to RGBA."
msgstr "將圖片從 HSLA 色彩空間轉換為 RGBA。"

#: src/effects/effect_groups.js:4 resources/ui/pages/applications.ui:12
#: resources/ui/pages/shell/app-folders.ui:8
#: resources/ui/pages/shell/component.ui:8 resources/ui/pages/shell/dash.ui:8
#: resources/ui/pages/shell/overview.ui:8 resources/ui/pages/shell/panel.ui:8
#: resources/ui/pages/shell/popup.ui:8
msgid "Blur"
msgstr "模糊"

#: src/effects/effect_groups.js:18
msgid "Texture"
msgstr "紋理"

#: src/effects/effect_groups.js:28
msgid "Advanced"
msgstr "進階"

#: src/effects/effect_groups.js:29
msgid "Building blocks that are mostly useful combined with other effects."
msgstr "基礎元件多用於與其他效果搭配組合。"

#: src/effects/refraction/info.js:7
msgid "Liquid Glass"
msgstr "液態玻璃"

#: src/effects/refraction/info.js:8
msgid ""
"A glossy translucent material with edge refraction, rim lighting, tint, and "
"inner shadow."
msgstr "具有邊緣折射、邊緣高光、色調與內陰影的光澤半透明材質。"

#: src/effects/refraction/info.js:11
msgid "Refraction scale"
msgstr "折射強度"

#: src/effects/refraction/info.js:12
msgid "How strongly the glass bends the sampled blur texture."
msgstr "玻璃彎曲所取樣模糊紋理的強度。"

#: src/effects/refraction/info.js:21
msgid "Blur radius"
msgstr "模糊半徑"

#: src/effects/refraction/info.js:22
msgid "Blurs the sampled backdrop before the liquid-glass shader is applied."
msgstr "在應用液態玻璃著色器之前，先對取樣的背景進行模糊。"

#: src/effects/refraction/info.js:31
msgid "Bezel width"
msgstr "邊框寬度"

#: src/effects/refraction/info.js:32
msgid "How far the liquid-glass lens reaches inward from the edge."
msgstr "液態玻璃透鏡從邊緣向內延伸的距離。"

#: src/effects/refraction/info.js:41
msgid "Rim spread"
msgstr "邊緣擴散"

#: src/effects/refraction/info.js:42
msgid "How far the refraction eases inward from the glass edge."
msgstr "折射從玻璃邊緣向內平滑過渡的範圍。"

#: src/effects/refraction/info.js:51
msgid "Refraction reach"
msgstr "折射範圍"

#: src/effects/refraction/info.js:52
msgid ""
"How far the bend reaches inward from the edge, past the corner radius. A "
"wider bend is also deeper, like a wider bezel (0 keeps it at the rim)."
msgstr "彎曲從邊緣向內延伸、越過圓角半徑的距離。彎曲範圍越寬，深度也越大，類似更寬的邊框（0 表示保持在邊緣）。"

#: src/effects/refraction/info.js:61
msgid "Glass thickness"
msgstr "玻璃厚度"

#: src/effects/refraction/info.js:62
msgid "Depth used by the refraction edge profile."
msgstr "折射邊緣輪廓所使用的深度。"

#: src/effects/refraction/info.js:71
msgid "Refraction style"
msgstr "折射樣式"

#: src/effects/refraction/info.js:72
msgid ""
"Shape of the bend near the edge. Low values bend softly, higher values bend "
"more sharply right at the edge."
msgstr "邊緣附近彎曲的形狀。數值較低時彎曲平緩，數值較高時在邊緣處彎曲更陡峭。"

#: src/effects/refraction/info.js:81
msgid "Fresnel glare"
msgstr "菲涅爾眩光"

#: src/effects/refraction/info.js:82
msgid "Strength of the directional fresnel glare from the glass edge."
msgstr "來自玻璃邊緣的方向性菲涅爾眩光強度。"

#: src/effects/refraction/info.js:91
msgid "Fresnel glare angle"
msgstr "菲涅爾眩光角度"

#: src/effects/refraction/info.js:92
msgid ""
"Direction or axis of the fresnel glare, in degrees (positive rotates "
"clockwise). In two-sided mode, 0 lights the top and bottom edges; in one-"
"sided mode, only the edge facing the light angle is lit (0 for top, 180 for "
"bottom)."
msgstr ""
"菲涅爾眩光的方向或軸向，單位為度（正值順時針旋轉）。在雙側模式下，0 照亮上下邊緣；在單側模式下，只照亮面向光線角度的邊緣（0 "
"為上側，180 為下側）。"

#: src/effects/refraction/info.js:101
msgid "Fresnel glare width"
msgstr "菲涅爾眩光寬度"

#: src/effects/refraction/info.js:102
msgid "Thickness multiplier of the fresnel glare ring along the glass edge."
msgstr "沿玻璃邊緣的菲涅爾眩光環厚度乘數。"

#: src/effects/refraction/info.js:111
msgid "Two-sided fresnel glare"
msgstr "雙側菲涅爾眩光"

#: src/effects/refraction/info.js:112
msgid ""
"Light opposite edge pairs symmetrically. When disabled, only the edge facing "
"the fresnel angle is lit (e.g. 180 lights the bottom edge, removing the "
"glare from the top)."
msgstr "對稱地照亮相對的兩組邊緣。禁用時，只照亮面向菲涅爾角度的邊緣（例如 180 照亮下邊緣，同時移除上邊緣的眩光）。"

#: src/effects/refraction/info.js:116
msgid "Specular glare strength"
msgstr "鏡面眩光強度"

#: src/effects/refraction/info.js:117
msgid ""
"Strength of the white specular glare on the same edge pair as the fresnel "
"glare, brighter on the light side (0 disables it)."
msgstr "與菲涅爾眩光同一組邊緣上的白色鏡面眩光強度，向光一側更亮（0 表示禁用）。"

#: src/effects/refraction/info.js:126
msgid "Edge border"
msgstr "邊緣描線"

#: src/effects/refraction/info.js:127
msgid ""
"Thin dark line along the straight side edges, away from the fresnel glare, "
"outlining the glass on light backgrounds."
msgstr "沿筆直側邊緣分佈的深色細線，不與菲涅爾眩光重疊，在淺色背景上勾勒出玻璃的輪廓。"

#: src/effects/refraction/info.js:136
msgid "Edge glow"
msgstr "邊緣輝光"

#: src/effects/refraction/info.js:137
msgid "Colorful content under the glass lights up its edge."
msgstr "玻璃下的彩色內容會點亮其邊緣。"

#: src/effects/refraction/info.js:146
msgid "Tint strength"
msgstr "色調強度"

#: src/effects/refraction/info.js:147
msgid "Amount of subtle milky glass tint over the blurred texture."
msgstr "覆蓋在模糊紋理上的輕微乳白玻璃色調的強度。"

#: src/effects/refraction/info.js:156
msgid "Tint color"
msgstr "色調顏色"

#: src/effects/refraction/info.js:157
msgid "Color blended over the blurred texture, weighted by the tint strength."
msgstr "混合在模糊紋理之上的顏色，混合程度由色調強度決定。"

#: src/effects/refraction/info.js:162
msgid "Backdrop zoom"
msgstr "背景縮放"

#: src/effects/refraction/info.js:163
msgid "Zoom level of the backdrop visible through the glass."
msgstr "透過玻璃可見背景的縮放級別。"

#: src/effects/refraction/info.js:172
msgid "Inner shadow"
msgstr "內陰影"

#: src/effects/refraction/info.js:173
msgid "Darkens the lower and inner edge for a deeper glass surface."
msgstr "加深下側和內側邊緣，呈現更有層次的玻璃表面。"

#: src/effects/refraction/info.js:182
msgid "Chromatic dispersion"
msgstr "色散"

#: src/effects/refraction/info.js:183
msgid "Physical per-channel refraction dispersion at the glass edge."
msgstr "玻璃邊緣處按顏色通道進行的物理折射色散。"

#: src/effects/refraction/info.js:192
msgid "Edge behavior"
msgstr "邊緣處理方式"

#: src/effects/refraction/info.js:193
msgid "How texture coordinates outside the actor are sampled."
msgstr "超出物件範圍的紋理座標的取樣方式。"

#: src/effects/refraction/info.js:196
msgid "Clamp"
msgstr "鉗制"

#: src/effects/refraction/info.js:197
msgid "Mirror"
msgstr "鏡像"

#: src/effects/texture/info.js:12
msgid "Image"
msgstr "圖片"

#: src/effects/texture/info.js:13
msgid "Blends an image into the pipeline."
msgstr "將圖片融入管道。"

#: src/effects/texture/info.js:16
msgid "Image path"
msgstr "圖片路徑"

#: src/effects/texture/info.js:17
msgid "Absolute path to the image file."
msgstr "圖片檔案的絕對路徑。"

#: src/effects/texture/info.js:21
msgid "Blend"
msgstr "混合"

#: src/effects/texture/info.js:22
msgid "How strongly the image is blended in."
msgstr "圖片融入的強度。"

#: src/effects/texture/info.js:32
msgid "How the image is blended in."
msgstr "圖片的混合方式。"

#: src/effects/texture/info.js:56
msgid "Image mode"
msgstr "圖片模式"

#: src/effects/texture/info.js:57
msgid "Tile the image, stretch it, or fit its width to the monitor."
msgstr "並排圖片、拉伸圖片，或將其寬度調整為符合顯示器。"

#: src/effects/texture/info.js:60
msgid "Tile"
msgstr "並排"

#: src/effects/texture/info.js:61
msgid "Stretch"
msgstr "拉伸"

#: src/effects/texture/info.js:62
msgid "Fit width"
msgstr "符合寬度"

#: src/effects/texture/info.js:66 resources/ui/pages/applications.ui:75
msgid "Opacity"
msgstr "不透明度"

#: src/effects/texture/info.js:67
msgid "Opacity of the image blend."
msgstr "圖片混合的不透明度。"

#: src/effects/texture/info.js:79
msgid "Pixelize"
msgstr "像素化"

#: src/effects/texture/info.js:80
msgid "An effect that pixelizes the image."
msgstr "將圖片像素化的效果。"

#: src/effects/texture/info.js:83 src/effects/texture/info.js:108
#: src/effects/texture/info.js:133
msgid "Factor"
msgstr "因素"

#: src/effects/texture/info.js:84 src/effects/texture/info.js:109
msgid "How much to scale down the image."
msgstr "將圖片縮小多少畫質。"

#: src/effects/texture/info.js:91 src/effects/texture/info.js:116
msgid "Downsampling mode"
msgstr "降採樣模式"

#: src/effects/texture/info.js:92 src/effects/texture/info.js:117
msgid "The downsampling method that is used."
msgstr "降採樣模式的方式。"

#: src/effects/texture/info.js:95 src/effects/texture/info.js:120
msgid "Boxcar"
msgstr "Boxcar"

#: src/effects/texture/info.js:96 src/effects/texture/info.js:121
msgid "Triangular"
msgstr "三角形的"

#: src/effects/texture/info.js:97 src/effects/texture/info.js:122
msgid "Dirac"
msgstr "狄拉克"

#: src/effects/texture/info.js:104
msgid "Downscale (advanced effect)"
msgstr "降低畫質 (進階效果)"

#: src/effects/texture/info.js:105
msgid "An effect that downscales the image and puts it in the top-left corner."
msgstr "縮小圖片並將其放在左上角的效果。"

#: src/effects/texture/info.js:129
msgid "Upscale (advanced effect)"
msgstr "提高畫質 (進階效果)"

#: src/effects/texture/info.js:130
msgid "An effect that upscales the image from the top-left corner."
msgstr "一個放大圖片並把它放在左上角角落的效果。"

#: src/effects/texture/info.js:134
msgid "How much to scale up the image."
msgstr "將圖片提高多少畫質。"

#: src/effects/texture/info.js:144
msgid "Derivative"
msgstr "導數"

#: src/effects/texture/info.js:145
msgid "Apply a spatial derivative, or a laplacian."
msgstr "套用一個空間導數或一個拉普拉斯算子。"

#: src/effects/texture/info.js:148
msgid "Operation"
msgstr "運算"

#: src/effects/texture/info.js:149
msgid "The mathematical operation to apply."
msgstr "執行的數學運算。"

#: src/effects/texture/info.js:152
msgid "1-step derivative"
msgstr "一階導數"

#: src/effects/texture/info.js:153
msgid "2-step derivative"
msgstr "二階導數"

#: src/effects/texture/info.js:154
msgid "Laplacian"
msgstr "拉普拉斯"

#: src/effects/texture/info.js:161 src/effects/texture/info.js:165
msgid "Noise"
msgstr "雜訊"

#: src/effects/texture/info.js:162
msgid "An effect that adds random grain to the image."
msgstr "為圖片加入隨機顆粒的效果。"

#: src/effects/texture/info.js:166
msgid "The amount of noise to add."
msgstr "雜訊增加的大小。"

#: src/effects/texture/info.js:175
msgid "Lightness"
msgstr "亮度"

#: src/effects/texture/info.js:176
msgid ""
"The luminosity of the noise. A setting of '1.0' will make the effect "
"transparent."
msgstr "雜訊的光度。設置為'1.0'會將效果完全透明。"

#: src/effects/wave/info.js:7
msgid "Vapor Wave"
msgstr "蒸氣波"

#: src/effects/wave/info.js:8
msgid ""
"A flowing wave displacement for a lively and dynamic feel with natural "
"movement."
msgstr "流動的波浪位移效果，帶來自然生動、富有動感的視覺體驗。"

#: src/effects/wave/info.js:11
msgid "Wave frequency"
msgstr "波浪頻率"

#: src/effects/wave/info.js:12
msgid "How tightly packed the ripples are."
msgstr "波紋的密集程度。"

#: src/effects/wave/info.js:21
msgid "Wave amplitude"
msgstr "波浪振幅"

#: src/effects/wave/info.js:22
msgid "How strongly the image gets displaced by the waves."
msgstr "圖片受波浪位移影響的強度。"

#: src/effects/wave/info.js:31
msgid "Wave octaves"
msgstr "波浪倍頻"

#: src/effects/wave/info.js:32
msgid ""
"Detail level of the wave shape. Higher adds more detail at the cost of "
"performance."
msgstr "波浪形狀的細節層次。數值越高細節越豐富，但會降低效能。"

#: src/effects/wave/info.js:39
msgid "Vapor octaves"
msgstr "蒸氣倍頻"

#: src/effects/wave/info.js:40
msgid ""
"Detail level of the misty texture. Higher adds more detail at the cost of "
"performance."
msgstr "霧狀紋理的細節層次。數值越高細節越豐富，但會降低效能。"

#: src/effects/wave/info.js:47
msgid "Vapor speed"
msgstr "蒸氣速度"

#: src/effects/wave/info.js:48
msgid "How quickly the misty vapor texture drifts over time."
msgstr "霧狀蒸氣紋理隨時間飄移的速度。"

#: src/effects/wave/info.js:57
msgid "Texture grain"
msgstr "紋理顆粒"

#: src/effects/wave/info.js:58
msgid "Adds a fine sandblasted texture to the image."
msgstr "為圖片加入細緻的噴砂質感。"

#: src/effects/wave/info.js:68
msgid "The saturation of the effect."
msgstr "效果的飽和度。"

#: src/effects/wave/info.js:78
msgid "The brightness of the effect."
msgstr "效果的亮度。"

#: src/effects/wave/info.js:87
msgid "Zoom"
msgstr "縮放"

#: src/effects/wave/info.js:88
msgid "Magnifies the backdrop toward the surface's center."
msgstr "以表面中心為基準放大背景。"

#: src/effects/wave/info.js:97
msgid "Dispersion"
msgstr "色散"

#: src/effects/wave/info.js:98
msgid "Chromatic aberration strength for a glitchy feel."
msgstr "營造故障感的色差強度。"

