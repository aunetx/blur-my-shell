#: resources/ui/applications.ui:5
msgid "Applications"
msgstr "Các ứng dụng"

#: resources/ui/applications.ui:10
msgid "Applications blur"
msgstr "Làm mờ cho các ứng dụng"

#: resources/ui/applications.ui:11
msgid "Adds blur to applications."
msgstr ""

#: resources/ui/applications.ui:20 resources/ui/dash.ui:20
#: resources/ui/panel.ui:20 resources/ui/popup.ui:20
msgid "Blur type"
msgstr "Loại hiệu ứng mờ"

#: resources/ui/applications.ui:21
msgid ""
"Static blur follows the wallpaper; dynamic blur samples live content behind "
"windows. Both use the selected pipeline."
msgstr ""

#: resources/ui/applications.ui:41 resources/ui/dash.ui:41
#: resources/ui/panel.ui:41 resources/ui/popup.ui:41
msgid "Static"
msgstr "Tĩnh"

#: resources/ui/applications.ui:53 resources/ui/dash.ui:53
#: resources/ui/panel.ui:53 resources/ui/popup.ui:53
msgid "Dynamic"
msgstr "Động"

