#: src/effects/blur/info.js:7
msgid "Dual Kawase blur"
msgstr "Làm mờ kép Kawase"

#: src/effects/blur/info.js:8
msgid "A fast, high-quality blur."
msgstr "Hiệu ứng làm mờ nhanh và chất lượng cao."

#: src/effects/blur/info.js:11
msgid "Radius"
msgstr "Bán kính"

#: src/effects/blur/info.js:12
msgid "The intensity of the blur effect."
msgstr "Cường độ của hiệu ứng mờ."

#: src/effects/blur/info.js:21 src/effects/wave/info.js:77
msgid "Brightness"
msgstr "Độ sáng"

#: src/effects/blur/info.js:22
msgid ""
"The brightness of the blur effect, a high value might make the text harder "
"to read."
msgstr "Độ sáng của hiệu ứng mờ, giá trị cao có thể khiến chữ khó đọc hơn."

#: src/effects/color/info.js:10 src/effects/color/info.js:15
#: src/effects/color/info.js:41 src/effects/effect_groups.js:11
msgid "Color"
msgstr "Màu"

#: src/effects/color/info.js:11
msgid "An effect that blends a color into the pipeline."
msgstr "Hiệu ứng hòa trộn màu vào trong pipeline."

#: src/effects/color/info.js:16
msgid ""
"The color to blend in. The blending amount is controlled by the opacity of "
"the color."
msgstr "Màu để pha. Mức độ pha dược điều khiển bởi độ trong suốt của màu."

#: src/effects/color/info.js:21
msgid "Blend mode"
msgstr "Chế độ pha màu"

#: src/effects/color/info.js:22
msgid "How the color is blended in."
msgstr "Cách màu được pha."

#: src/effects/color/info.js:25
msgid "Normal"
msgstr "Bình thường"

#: src/effects/color/info.js:26
msgid "Multiply"
