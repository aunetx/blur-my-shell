msgid "Plus darker"
msgstr "Làm tối cộng"

#: src/effects/color/info.js:32
msgid "Plus lighter"
msgstr "Làm sáng cộng"

#: src/effects/color/info.js:33
msgid "Color dodge"
msgstr "Giảm phơi sáng"

#: src/effects/color/info.js:34
msgid "Color burn"
msgstr "Tăng phơi sáng"

#: src/effects/color/info.js:35
msgid "Hard light"
msgstr "Ánh sáng mạnh"

#: src/effects/color/info.js:36
msgid "Soft light"
msgstr "Ánh sáng nhẹ"

#: src/effects/color/info.js:37
msgid "Difference"
msgstr "Khác biệt"

#: src/effects/color/info.js:38
msgid "Exclusion"
msgstr "Loại trừ"

#: src/effects/color/info.js:39
msgid "Hue"
msgstr "Sắc độ"

#: src/effects/color/info.js:40 src/effects/color/info.js:93
#: src/effects/wave/info.js:67
msgid "Saturation"
msgstr "Bão hoà"

#: src/effects/color/info.js:42 src/effects/color/info.js:49
msgid "Luminosity"
msgstr "Tính sáng"

#: src/effects/color/info.js:50
msgid "An effect that affects the luminosity of the image."
msgstr "Hiệu ứng ảnh hưởng đến tính sáng của hình ảnh."

#: src/effects/color/info.js:53
msgid "Shift brightness"
msgstr "Chuyển dịch độ sáng"

#: src/effects/color/info.js:54
msgid "The brightness to add or remove from the image."
msgstr "Thêm hoặc bớt độ sáng của hình ảnh."

#: src/effects/color/info.js:63
msgid "Brightness multiplier"
msgstr "Nhân cấp độ sáng"

#: src/effects/color/info.js:64
msgid ""
"Multiplies image brightness; 0 is black and 1 leaves brightness unchanged."
msgstr ""
"Nhân cấp độ sáng của hình ảnh; 0 là đen hoàn toàn và 1 không để lại thay đổi "
"gì."

#: src/effects/color/info.js:73
msgid "Contrast"
msgstr "Độ tương phản"

#: src/effects/color/info.js:74
msgid "Adjusts image contrast around the selected contrast center."
msgstr ""
"Hiệu chỉnh độ tương phản của hình ảnh qua giá trị điểm giữa tương phản được "
"chọn."

#: src/effects/color/info.js:83
msgid "Contrast center"
msgstr "Điểm giữa tương phản"

#: src/effects/color/info.js:84
msgid "The center of the contrast to use."
msgstr "Điểm giữa tương phản để sử dụng."

#: src/effects/color/info.js:94
msgid ""
"Multiplies image saturation; 0 removes all color and 1 leaves saturation "
"unchanged."
msgstr ""
"Nhân độ bão hòa màu của hình ảnh; 0 bỏ toàn bộ màu và 1 không để lại thay "
"đổi nào."

#: src/effects/color/info.js:106
msgid "RGB to HSL (advanced effect)"
msgstr "Chuyển đổi RGB sang HSL (hiệu ứng nâng cao)"

#: src/effects/color/info.js:107
msgid "Converts the image from RGBA color space to HSLA."
msgstr "Chuyển đổi hình ảnh từ không gian màu RGBA sang HSLA."

#: src/effects/color/info.js:112
msgid "HSL to RGB (advanced effect)"
msgstr "Chuyển đổi HSL sang RGB (hiệu ứng nâng cao)"

#: src/effects/color/info.js:113
msgid "Converts the image from HSLA color space to RGBA."
msgstr "Chuyển đổi hình ảnh từ không gian màu HSLA sang RGBA."

