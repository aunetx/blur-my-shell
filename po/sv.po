msgstr "Inga"

#: resources/ui/pages/pipelines/pipeline-page.ui:11
#: src/preferences/pages/pipelines/pipeline_row.js:61
msgid "Pipeline Menu"
msgstr "Bearbetningskedjemeny"

#: resources/ui/pages/pipelines/pipeline-page.ui:24
msgid "Name"
msgstr "Namn"

#: resources/ui/pages/pipelines/pipeline-page.ui:30
msgid "Pipeline ID"
msgstr "Bearbetningskedje-ID"

#: resources/ui/pages/pipelines/pipeline-page.ui:36
msgid "Copy"
msgstr "Kopiera"

#: resources/ui/pages/pipelines/pipeline-page.ui:49
msgid "Effects"
msgstr "Effekter"

#: resources/ui/pages/pipelines/pipeline-page.ui:56
#: src/preferences/pages/pipelines/effect_chooser.js:13
msgid "Add Effect"
msgstr "Lägg till effekter"

#: resources/ui/pages/pipelines/pipeline-page.ui:73
#: src/preferences/pages/pipelines/pipeline_row.js:75
msgid "No effects yet"
msgstr "Inga effekter ännu"

#: resources/ui/pages/pipelines/pipeline-page.ui:94
#: src/preferences/pages/pipelines/pipeline_row.js:42
msgid "Duplicate"
msgstr "Duplicera"

#: resources/ui/pages/pipelines/pipeline-page.ui:98
#: src/preferences/pages/pipelines/index.js:122
#: src/preferences/pages/pipelines/pipeline_row.js:43
