msgstr "Beteende"

#: resources/ui/pages/applications.ui:95
msgid "Blur on overview"
msgstr "Oskärpa på översiktsläget"

#: resources/ui/pages/applications.ui:96
msgid "Shows the blur on every workspace, at some performance cost"
msgstr "Visar oskärpan på varje arbetsyta, med viss prestandakostnad"

#: resources/ui/pages/applications.ui:102
msgid "Unblur when Fullscreen"
msgstr "Ta bort oskärpa i helskärmsläge"

#: resources/ui/pages/applications.ui:108
msgid "Blur all windows"
msgstr "Ge alla fönster oskärpa"

#: resources/ui/pages/applications.ui:109
msgid "When off, only the windows listed below are blurred."
msgstr "Om avstängt får bara fönstren nedan oskärpa."

#: resources/ui/pages/applications.ui:117
msgid "Blurred windows"
msgstr "Fönster med oskärpa"

#: resources/ui/pages/applications.ui:118
#: resources/ui/pages/applications.ui:140
msgid ""
"Use * to match any characters, like Firefox* or *Code*, and ? to match a "
"single one."
msgstr ""

#: resources/ui/pages/applications.ui:126
#: resources/ui/pages/applications.ui:148
