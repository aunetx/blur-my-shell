msgid "Appearance"
msgstr "Utseende"

#: resources/ui/pages/applications.ui:41
msgid "Opacity"
msgstr "Opacitet"

#: resources/ui/pages/applications.ui:42
msgid "Higher values are easier to read"
msgstr "Högre värden är lättare att läsa"

#: resources/ui/pages/applications.ui:62
msgid "Opaque focused window"
msgstr "Ogenomskinligt fokuserat fönster"

#: resources/ui/pages/applications.ui:68 resources/ui/pages/shell/panel.ui:44
